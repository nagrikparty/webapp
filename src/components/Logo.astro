---
// src/components/Logo.astro
// Renders the canonical Nagrik Party logo
interface Props {
  width?: number;
  height?: number;
  className?: string;
  variant?: "full" | "icon" | "stacked";
}

const { width, height, className = "", variant = "full" } = Astro.props;
---

<img
  src="/nagrikpartylogo.svg"
  alt="Nagrik Party"
  width={width}
  height={height}
  class={`nagrik-logo ${className}`}
  data-variant={variant}
  loading="eager"
  decoding="async"
  style={{
    maxWidth: "100%",
    height: height ? `${height}px` : "auto",
    width: width ? `${width}px` : "auto",
    aspectRatio: "1150 / 700",
    objectFit: "contain",
    display: "inline-block",
    verticalAlign: "middle",
  }}
/>
