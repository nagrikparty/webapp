---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { AuthFlow } from "@/components/AuthFlow";
---

<BaseLayout
  title="Forgot Password - Nagrik Party"
  description="Reset your Nagrik Party account password."
  bodyClass="auth-page"
>
  <section class="page-hero" style="padding-bottom: 24px; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <h1 style="margin: 0 auto; font-family: var(--font-serif); font-weight: 700; font-size: 2.5rem; letter-spacing: -0.02em; color: var(--ink);">
        <Bilingual en="Reset Password" hi="पासवर्ड रीसेट करें" />
      </h1>
      <p style="color: var(--muted); font-size: 14px; margin: 8px auto 0; max-width: 480px;">
        <Bilingual en="Enter your registered email address to receive password recovery instructions." hi="पासवर्ड रिकवरी निर्देश प्राप्त करने के लिए अपना पंजीकृत ईमेल पता दर्ज करें।" />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 16px; min-height: 55vh; position: relative; z-index: 10;">
    <div class="container">
      <AuthFlow client:load initialMode="forgot-password" />
    </div>
  </section>
</BaseLayout>
