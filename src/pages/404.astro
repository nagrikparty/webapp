---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Nagrik Party | 404 - Document Not Found"
  description="The requested page, petition, or archival record could not be found."
>
  <section class="section page-offset" style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding-bottom: 48px; padding-left: 16px; padding-right: 16px;">
    <div style="
      background: var(--paper-card);
      border: 1px solid var(--line-strong);
      border-radius: 4px;
      box-shadow: var(--paper-shadow);
      max-width: 620px;
      width: 100%;
      padding: 40px 32px;
      text-align: center;
      position: relative;
    ">
      <div style="
        display: inline-block;
        border: 2px solid var(--red);
        color: var(--red);
        padding: 4px 14px;
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-radius: 3px;
        margin-bottom: 24px;
        transform: rotate(-2deg);
      ">
        ARCHIVAL RECORD NOT FOUND
      </div>

      <h1 style="
        font-family: var(--font-serif);
        font-size: 48px;
        color: var(--ink);
        margin: 0 0 12px;
        line-height: 1.1;
      ">
        404
      </h1>

      <p style="
        font-size: 18px;
        color: var(--ink);
        font-weight: 600;
        margin: 0 0 16px;
      ">
        This dossier or page does not exist in the public record.
      </p>

      <p style="
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 32px;
      ">
        The URL may be misspelled, the draft petition may have been re-indexed, or the record has moved to another section of the Formation Phase portal.
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
        <a href="/" class="button primary" style="min-height: 44px; border-radius: 3px; padding: 0 20px;">
          Central Desk
        </a>
        <a href="/crime" class="button yellow" style="min-height: 44px; border-radius: 3px; padding: 0 20px; font-weight: 700;">
          Verified Crime Tracker
        </a>
        <a href="/documents" class="button" style="min-height: 44px; border-radius: 3px; padding: 0 20px;">
          Document Vault
        </a>
        <a href="/membership" class="button" style="min-height: 44px; border-radius: 3px; padding: 0 20px;">
          Membership Induction
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
