---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
---

<BaseLayout
  title="404 - Document Not Found | Nagrik Party"
  description="The requested page, petition, or archival record could not be found."
>
  <section class="section" style="min-height: 65vh; display: flex; align-items: center; justify-content: center; padding: 48px 16px;">
    <div style="
      background: var(--paper-card);
      border: 1px solid var(--line-strong);
      border-radius: 4px;
      box-shadow: var(--paper-shadow);
      max-width: 620px;
      width: 100%;
      padding: 40px 32px;
      text-align: center;
      position: relative;
    ">
      <div style="
        display: inline-block;
        border: 2px solid var(--red);
        color: var(--red);
        padding: 4px 14px;
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-radius: 3px;
        margin-bottom: 24px;
        transform: rotate(-2deg);
      ">
        ARCHIVAL RECORD NOT FOUND / अभिलेख अप्राप्य
      </div>

      <h1 style="
        font-family: var(--font-serif);
        font-size: 48px;
        color: var(--ink);
        margin: 0 0 12px;
        line-height: 1.1;
      ">
        404
      </h1>

      <p style="
        font-size: 18px;
        color: var(--ink);
        font-weight: 600;
        margin: 0 0 16px;
      ">
        <Bilingual
          en="This dossier or page does not exist in the public record."
          hi="यह दस्तावेज़ या पृष्ठ सार्वजनिक अभिलेख में मौजूद नहीं है।"
        />
      </p>

      <p style="
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 32px;
      ">
        <Bilingual
          en="The URL may be misspelled, the draft petition may have been re-indexed, or the record has moved to another section of the Formation Phase portal."
          hi="हो सकता है कि यूआरएल गलत टाइप किया गया हो, मसौदा याचिका पुन: अनुक्रमित की गई हो, या रिकॉर्ड पोर्टल के किसी अन्य भाग में स्थानांतरित हो गया हो।"
        />
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
        <a href="/" class="button primary" style="min-height: 44px; border-radius: 3px; padding: 0 20px;">
          <Bilingual en="Central Desk" hi="मुख्य पृष्ठ" />
        </a>
        <a href="/crime" class="button yellow" style="min-height: 44px; border-radius: 3px; padding: 0 20px; font-weight: 700;">
          <Bilingual en="Verified Crime Tracker" hi="अपराध ट्रैकर" />
        </a>
        <a href="/documents" class="button" style="min-height: 44px; border-radius: 3px; padding: 0 20px;">
          <Bilingual en="Document Vault" hi="दस्तावेज़ लाइब्रेरी" />
        </a>
        <a href="/membership" class="button" style="min-height: 44px; border-radius: 3px; padding: 0 20px;">
          <Bilingual en="Membership Induction" hi="सदस्यता लें" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
