---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { legalLinks } from "@/lib/content";
---

<BaseLayout
  title="Nagrik Party | About"
  description="A Delhi-first proposed political party under registration. Building visible governance before power."
>
  <section class="page-hero">
    <div class="container">
      <h1>About Nagrik Party</h1>
      <p class="page-copy">
        Nagrik Party (Formation Phase): An independent political initiative working toward the formation and registration of a political party under Section 29A of the Representation of the People Act, 1951.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2 style="margin: 0 0 20px; font-size: 32px;">
            Kaam dikhna chahiye
          </h2>
          <p style="color: var(--ink); line-height: 1.65; font-size: 17px;">
            This is the core operating doctrine. Every workflow should produce a visible record: issue reported, volunteer assigned, escalation logged, representative response captured, public status updated, report published.
          </p>
        </div>
        <div>
          <div class="grid-2" style="gap: 14px;">
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 17px;">People's Opposition</h3>
              <p style="font-size: 14px;">Collect public problems, verify them, escalate lawfully, and publish accountability, without exposing sensitive citizen data.</p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 17px;">Hybrid democracy</h3>
              <p style="font-size: 14px;">Digital participation supports physical units and delegate systems. Not all democratic decisions happen online.</p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 17px;">Transparency with safeguards</h3>
              <p style="font-size: 14px;">Public dashboards are important, but complainant identity, women safety cases, legal aid requests, and whistleblower reports need strict privacy controls.</p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 17px;">Independent candidate home</h3>
              <p style="font-size: 14px;">A constitutional home for independent candidates, civic leaders, and public-service volunteers who want party infrastructure without opaque high-command politics.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="section-head">
        <h2>Delhi-first strategy</h2>
      </div>
      <div class="grid-3">
        <div class="card feature">
          <h3>70 Assembly constituencies</h3>
          <p>Launching as a Delhi-based party formation from day one. Building issue intake, manifesto priorities, volunteer signup, and membership application flows across all Delhi ACs.</p>
        </div>
        <div class="card feature">
          <h3>Okhla anchor</h3>
          <p>Founding Convener Arsalan Azad contested independently from Okhla in Delhi 2025. It serves as the first public proof point of the party's civic work approach.</p>
        </div>
        <div class="card feature">
          <h3>Expansion model</h3>
          <p>Expand operating depth constituency by constituency as volunteers, independent candidates, and local teams come together. National expansion after Delhi operations prove field readiness.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Registration status</h2>
      </div>
      <div class="notice" style="max-width: 780px;">
        <strong>Important:</strong> Nagrik Party is not yet registered with the Election Commission of India. Section 29A RPA 1951 registration is the first legal milestone. The party should be described as a proposed party or party under registration until ECI registration is complete. Recognised State party status is a separate, later electoral-performance milestone.
      </div>

      <div style="margin-top: 36px;">
        <strong style="display: block; margin-bottom: 14px; font-size: 18px;">
          Policy documents
        </strong>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          {legalLinks.map((link) => (
            <a class="button" href={`/legal/${link.slug}`}>
              {link.en}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
