---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TransparencyLedger } from "@/components/TransparencyLedger";
---

<BaseLayout
  title="Financial Transparency | Nagrik Party"
  description="Public disclosures, formation-phase financial accounts, and cashless audit ledger of Nagrik Party."
>
  <section class="page-hero">
    <div class="container" style="max-width: 1040px;">
      <div class="mini-label" style="background: rgba(29, 86, 53, 0.08); color: var(--green);">
        PHASE 1 · RADICAL TRANSPARENCY
      </div>
      <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); margin: 8px 0 12px; font-family: var(--font-serif);">
        Financial Transparency
      </h1>
      <p style="font-size: 16px; color: var(--ink-body); max-width: 680px; margin: 0; line-height: 1.6;">
        Clean politics begins with clean funding. We publish our complete formation accounts, receipts, and operational expenditures for full public accountability.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 32px; padding-bottom: 60px;">
    <div class="container" style="max-width: 1040px;">
      <div
        class="card"
        style="background: var(--paper-card); border: 1px solid var(--line-strong); border-left: 3px solid var(--green); padding: 18px 22px; border-radius: 4px; margin-bottom: 24px; box-shadow: var(--shadow);"
      >
        <span class="mini-label" style="background: rgba(29, 86, 53, 0.08); color: var(--green); font-size: 11px;">
          ZERO UNACCOUNTED FUNDS PLEDGE
        </span>
        <h3 style="font-size: 16px; font-weight: 700; margin: 8px 0 4px; font-family: var(--font-serif); color: var(--ink);">
          Zero Cash Donations Accepted
        </h3>
        <p style="font-size: 13.5px; color: var(--muted); margin: 0; line-height: 1.55;">
          Nagrik Party maintains 100% digital bank accounts. Every rupee received or spent is published in our Audited Financial Statements with complete source provenance.
        </p>
      </div>

      <TransparencyLedger client:only="react" />
    </div>
  </section>
</BaseLayout>
