---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PublicDocumentsLibrary } from "@/components/PublicDocumentsLibrary";
---

<BaseLayout
  title="Public Documents & Charters | Nagrik Party"
  description="Foundational charters, draft constitution, and statutory filings of Nagrik Party"
>
  <section class="page-hero">
    <div class="container">
      <div class="mini-label" style="background: rgba(22, 53, 92, 0.08); color: var(--blue); padding: 4px 10px; border-radius: 2px; margin-bottom: 12px; display: inline-block;">Statutory & Governance Archive</div>
      <h1>Public Documents & Charters</h1>
      <p class="page-copy">
        Access all official foundational charters, the draft party constitution, codes of conduct, and statutory declarations under RPA 1951.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <div class="container">
      <PublicDocumentsLibrary client:only="react" />
    </div>
  </section>
</BaseLayout>
