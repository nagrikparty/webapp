---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { PublicDocumentsLibrary } from "@/components/PublicDocumentsLibrary";
---

<BaseLayout
  title="Public Documents & Charters - Nagrik Party"
  description="Foundational charters, draft constitution, and statutory filings of Nagrik Party"
>
  <section class="page-hero">
    <div class="container">
      <div class="mini-label">Statutory & Governance Archive</div>
      <h1>
        <Bilingual en="Public Documents & Charters" hi="सार्वजनिक दस्तावेज़ और घोषणापत्र" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Access all official foundational charters, the draft party constitution, codes of conduct, and statutory declarations under RPA 1951."
          hi="आरपीए 1951 के तहत सभी आधिकारिक संस्थापक घोषणापत्र, पार्टी संविधान का मसौदा, आचार संहिता और वैधानिक घोषणाओं तक पहुंचें।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <div class="container">
      <PublicDocumentsLibrary client:only="react" />
    </div>
  </section>
</BaseLayout>
