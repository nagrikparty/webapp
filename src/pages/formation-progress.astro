---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFormationProgress } from "@/lib/progress-service";
import { AlertCircle } from "lucide-react";

export const prerender = false;

const progress = await getFormationProgress();
---

<BaseLayout
  title="Formation Progress & Roadmap | Nagrik Party"
  description="A transparent, step-by-step account of our legal and organisational journey toward registration under Section 29A RPA 1951."
>
  <section class="page-hero">
    <div class="container" style="max-width: 960px;">
      <div class="mini-label" style="background: rgba(179, 74, 21, 0.08); color: var(--saffron);">
        PHASE 1 · FORMATION PHASE
      </div>
      <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); margin: 8px 0 12px; font-family: var(--font-serif);">
        Formation Progress & Roadmap
      </h1>
      <p style="font-size: 16px; color: var(--ink-body); max-width: 700px; margin: 0; line-height: 1.6;">
        A transparent account of our organizational and statutory milestones toward registration under Section 29A of the Representation of the People Act, 1951.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 32px; padding-bottom: 60px;">
    <div class="container" style="max-width: 960px;">
      
      <!-- Strict Statutory Disclosure -->
      <div
        class="card"
        style="background: var(--paper-card); border: 1px solid var(--line-strong); border-left: 3px solid var(--saffron); padding: 18px 22px; border-radius: 4px; margin-bottom: 28px; display: flex; gap: 14px; align-items: flex-start; box-shadow: var(--shadow);"
      >
        <AlertCircle size={20} style={{ color: "var(--saffron)", flexShrink: 0, marginTop: "2px" }} />
        <div>
          <strong style="font-size: 14.5px; color: var(--ink); font-family: var(--font-serif);">Statutory Disclosure</strong>
          <p style="font-size: 13px; color: var(--muted); margin: 4px 0 0; line-height: 1.55;">
            Nagrik Party is in <strong>Phase 1, Formation Phase</strong>. We do not claim registered-party status, official recognition, or an allotted election symbol until final Gazette notification by the Election Commission of India under Section 29A RPA 1951.
          </p>
        </div>
      </div>

      <!-- Weighted Progress Summary Card -->
      <div
        class="card"
        style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: 24px 28px; box-shadow: var(--shadow); margin-bottom: 32px;"
      >
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
          <div>
            <div style="font-size: 11px; font-weight: 700; color: var(--muted); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em;">
              OVERALL FORMATION PROGRESS
            </div>
            <div style="font-size: 28px; font-weight: 800; font-family: var(--font-mono); color: var(--saffron); line-height: 1.1; margin-top: 2px;">
              {progress.percentage}%
            </div>
          </div>
          <div style="text-align: left;">
            <div style="font-size: 13px; font-weight: 600; color: var(--ink);">
              {progress.completedCount} Completed · {progress.inProgressCount} In Progress · {progress.totalMilestones - progress.completedCount - progress.inProgressCount} Upcoming
            </div>
            <small style="color: var(--muted); font-size: 11.5px;">
              {progress.isOverride ? "Audited progress override active" : "Computed from weighted statutory milestones"}
            </small>
          </div>
        </div>

        <div style="width: 100%; height: 10px; background: var(--paper-subtle); border-radius: 5px; overflow: hidden; border: 1px solid var(--line);">
          <div style={`width: ${progress.percentage}%; height: 100%; background: linear-gradient(90deg, var(--saffron), #d4631f); border-radius: 4px;`} />
        </div>
      </div>

      <!-- Milestone Timeline List -->
      <div style="display: grid; gap: 16px;">
        {progress.milestones.map((st) => (
          <div
            class="card"
            style={{
              background: "var(--paper-card)",
              borderRadius: "4px",
              padding: "22px 24px",
              border: st.status === "IN_PROGRESS" ? "1.5px solid var(--saffron)" : "1px solid var(--line)",
              boxShadow: "var(--shadow)",
            }}
          >
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span
                  style={{
                    display: "inline-flex",
                    alignItems: "center",
                    justifyContent: "center",
                    width: "28px",
                    height: "28px",
                    borderRadius: "2px",
                    fontSize: "12px",
                    fontWeight: 700,
                    fontFamily: "var(--font-mono)",
                    background: st.status === "COMPLETED" ? "rgba(29, 86, 53, 0.1)" : st.status === "IN_PROGRESS" ? "rgba(179, 74, 21, 0.1)" : "var(--paper-subtle)",
                    color: st.status === "COMPLETED" ? "var(--green)" : st.status === "IN_PROGRESS" ? "var(--saffron)" : "var(--muted)",
                    border: "1px solid var(--line)",
                  }}
                >
                  {st.sort_order}
                </span>

                <div>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 11px; font-weight: 700; color: var(--muted); font-family: var(--font-mono); text-transform: uppercase;">
                      {st.category}
                    </span>
                    <span style="font-size: 11px; color: var(--ink-faint); font-family: var(--font-mono);">
                      · Weight: {st.weight}x
                    </span>
                  </div>
                  <h3 style="font-size: 17px; font-weight: 700; margin: 2px 0 0; font-family: var(--font-serif); color: var(--ink);">
                    {st.title}
                  </h3>
                </div>
              </div>

              <span
                style={{
                  fontFamily: "var(--font-mono)",
                  fontSize: "11.5px",
                  fontWeight: 700,
                  padding: "3px 8px",
                  borderRadius: "2px",
                  textTransform: "uppercase",
                  background: st.status === "COMPLETED" ? "rgba(29, 86, 53, 0.08)" : st.status === "IN_PROGRESS" ? "rgba(179, 74, 21, 0.08)" : "var(--paper-subtle)",
                  color: st.status === "COMPLETED" ? "var(--green)" : st.status === "IN_PROGRESS" ? "var(--saffron)" : "var(--muted)",
                  border: "1px solid var(--line)",
                }}
              >
                {st.status === "COMPLETED" ? "Completed" : st.status === "IN_PROGRESS" ? "In Progress" : "Upcoming"}
              </span>
            </div>

            <p style="font-size: 13.5px; color: var(--ink-body); line-height: 1.55; margin: 10px 0 12px; max-width: 760px;">
              {st.description}
            </p>

            {st.public_note && (
              <div style="font-size: 12.5px; color: var(--muted); background: var(--paper-subtle); padding: 8px 12px; border-radius: 2px; border-left: 2px solid var(--line-strong); margin-bottom: 10px;">
                <strong>Public Note:</strong> {st.public_note}
              </div>
            )}

            {st.evidence_url && (
              <div style="display: flex; justify-content: flex-end;">
                <a
                  href={st.evidence_url}
                  style="font-size: 12px; font-weight: 600; color: var(--saffron); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;"
                >
                  View Evidence / Charters &rarr;
                </a>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Action Footer -->
      <div style="text-align: center; margin-top: 40px; padding: 32px; background: var(--paper-card); border: 1px solid var(--line-strong); border-radius: 4px;">
        <h3 style="font-size: 18px; font-weight: 700; font-family: var(--font-serif); margin: 0 0 8px;">
          Participate in Reaching the Next Milestone
        </h3>
        <p style="font-size: 14px; color: var(--muted); max-width: 520px; margin: 0 auto 20px;">
          Founding member verification and constituency meetings are currently underway.
        </p>
        <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
          <a href="/membership" class="button button-primary">
            Join as Founding Member &rarr;
          </a>
          <a href="/build-with-us" class="button">
            Build With Us
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
