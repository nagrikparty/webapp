---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { CheckCircle2, Clock, ArrowRight, AlertCircle } from "lucide-react";
import { BRAND } from "@/lib/brand";

const stages = [
  {
    stage: 1,
    titleEn: "Platform Architecture & Privacy Vault",
    titleHi: "प्लेटफॉर्म आर्किटेक्चर और गोपनीयता वॉल्ट",
    status: "COMPLETED",
    descEn: "Built production-grade digital induction system, SHA-256 document hashing, zero-leak member card QR verification, and continuous regulatory export engine.",
    descHi: "उत्पादन-स्तरीय डिजिटल प्रेरण प्रणाली, SHA-256 दस्तावेज़ हैशिंग और नियामक निर्यात इंजन तैयार किया गया।",
  },
  {
    stage: 2,
    titleEn: "Party Constitution & Democratic By-laws",
    titleHi: "पार्टी संविधान और लोकतांत्रिक उपनियम",
    status: "COMPLETED",
    descEn: "Formulated democratic party constitution with mandatory periodic inner elections, non-violence pledge, and allegiance to the Constitution of India.",
    descHi: "अनिवार्य आंतरिक चुनावों और भारतीय संविधान के प्रति निष्ठा के साथ पार्टी संविधान का प्रारूप तैयार किया गया।",
  },
  {
    stage: 3,
    titleEn: "Founding Member Induction (100+ Verified Voters)",
    titleHi: "संस्थापक सदस्य प्रेरण (100+ सत्यापित मतदाता)",
    status: "ACTIVE",
    descEn: "Currently enrolling and verifying founding members with valid EPIC voter IDs across Delhi's 70 Assembly Constituencies. Individual affidavits and declarations collected.",
    descHi: "वर्तमान में दिल्ली के 70 विधानसभा क्षेत्रों में वैध मतदाता पहचान पत्र के साथ संस्थापक सदस्यों का नामांकन और सत्यापन जारी है।",
  },
  {
    stage: 4,
    titleEn: "General Body Convention & Executive Election",
    titleHi: "साधारण सभा सम्मेलन और कार्यकारी चुनाव",
    status: "UPCOMING",
    descEn: "Formal convention of all verified founding members to ratify party constitution and confirm office bearers including Party President Arsalan Azad.",
    descHi: "पार्टी संविधान की पुष्टि और पार्टी अध्यक्ष अरसलान आज़ाद सहित पदाधिकारियों की पुष्टि के लिए औपचारिक सम्मेलन।",
  },
  {
    stage: 5,
    titleEn: "Cashless Formation Accounts & Audit",
    titleHi: "कैशलेस गठन खाते और ऑडिट",
    status: "ACTIVE",
    descEn: "Maintenance of 100% digital bank accounts, audited voluntary contribution registers, and public transparency disclosures.",
    descHi: "100% डिजिटल बैंक खातों का रखरखाव, ऑडिटेड स्वैच्छिक योगदान रजिस्टर और सार्वजनिक प्रकटीकरण।",
  },
  {
    stage: 6,
    titleEn: "Public Statutory Notice in Daily Newspapers",
    titleHi: "दैनिक समाचार पत्रों में सार्वजनिक वैधानिक सूचना",
    status: "UPCOMING",
    descEn: "Publication of formal public notice in one national English daily and one national Hindi daily inviting public feedback as per ECI guidelines.",
    descHi: "ईसीआई दिशानिर्देशों के अनुसार अंग्रेजी और हिंदी के प्रमुख दैनिक समाचार पत्रों में सार्वजनिक सूचना का प्रकाशन।",
  },
  {
    stage: 7,
    titleEn: "Section 29A Application Filing at Nirvachan Sadan",
    titleHi: "निर्वाचन सदन में धारा 29A आवेदन दाखिल करना",
    status: "UPCOMING",
    descEn: "Physical submission of compiled, continuous page-numbered dossier (1..N) to the Election Commission of India within statutory time limits.",
    descHi: "निर्धारित समय सीमा के भीतर भारत के चुनाव आयोग को निरंतर पृष्ठ-संख्यांकित डोजियर प्रस्तुत करना।",
  },
  {
    stage: 8,
    titleEn: "ECI Scrutiny & Regulatory Due Diligence",
    titleHi: "ईसीआई जांच और नियामक समीक्षा",
    status: "UPCOMING",
    descEn: "Clarification rounds, document verification, and compliance scrutiny by the Election Commission of India Secretariat.",
    descHi: "भारत के चुनाव आयोग सचिवालय द्वारा दस्तावेज सत्यापन और अनुपालन जांच।",
  },
  {
    stage: 9,
    titleEn: "Gazette Notification & Registered Party Status",
    titleHi: "राजपत्र अधिसूचना और पंजीकृत पार्टी का दर्जा",
    status: "UPCOMING",
    descEn: "Official notification of party registration under Section 29A of the Representation of the People Act, 1951.",
    descHi: "लोक प्रतिनिधित्व अधिनियम, 1951 की धारा 29A के तहत पार्टी पंजीकरण की आधिकारिक अधिसूचना।",
  },
];
---

<BaseLayout
  title="Formation Progress & Roadmap - Nagrik Party"
  description="Transparent 9-stage roadmap towards formal political party registration under RPA 1951"
>
  <section class="page-hero">
    <div class="container">
      <div class="mini-label" style="background: rgba(245, 130, 32, 0.1); color: var(--saffron);">
        Phase 1 • Formation Milestone Tracker
      </div>
      <h1>
        <Bilingual en="Formation Roadmap" hi="गठन कार्ययोजना" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="A transparent, step-by-step account of our legal and organisational journey toward registration under Section 29A of the Representation of the People Act, 1951."
          hi="लोक प्रतिनिधित्व अधिनियम, 1951 की धारा 29A के तहत पंजीकरण की हमारी कानूनी और संगठनात्मक यात्रा का पारदर्शी विवरण।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <div class="container" style="max-width: 900px;">
      
      <!-- Statutory Transparency Alert -->
      <div class="card" style="background: #fff; border: 1px solid #ffd591; padding: 20px 24px; border-radius: 14px; margin-bottom: 32px; display: flex; gap: 14px; align-items: flex-start;">
        <AlertCircle size={22} style={{ color: "var(--saffron)", flexShrink: 0, marginTop: "2px" }} />
        <div>
          <strong style="font-size: 15px; color: var(--ink);">Strict Statutory Disclosure</strong>
          <p style="font-size: 13px; color: var(--muted); margin: 4px 0 0; line-height: 1.5;">
            Nagrik Party is currently in <strong>Stage 3 of Phase 1 (Formation Phase)</strong>. We do not claim registered-party status, official government recognition, or an allotted election symbol until final Gazette notification by the Election Commission of India.
          </p>
        </div>
      </div>

      <!-- Roadmap Timeline -->
      <div style="display: grid; gap: 20px;">
        {stages.map((st) => (
          <div
            class="card"
            style={{
              background: "#fff",
              borderRadius: "16px",
              padding: "24px 28px",
              border: st.status === "ACTIVE" ? `2px solid ${BRAND.colors.saffron}` : "1px solid var(--line)",
              position: "relative",
            }}
          >
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span
                  style={{
                    display: "inline-flex",
                    alignItems: "center",
                    justifyContent: "center",
                    width: "28px",
                    height: "28px",
                    borderRadius: "50%",
                    fontSize: "13px",
                    fontWeight: 800,
                    background:
                      st.status === "COMPLETED"
                        ? "rgba(0, 135, 62, 0.1)"
                        : st.status === "ACTIVE"
                        ? "rgba(245, 130, 32, 0.15)"
                        : "var(--paper)",
                    color:
                      st.status === "COMPLETED"
                        ? BRAND.colors.green
                        : st.status === "ACTIVE"
                        ? BRAND.colors.saffron
                        : "var(--muted)",
                  }}
                >
                  {st.stage}
                </span>

                <h3 style="font-size: 17px; font-weight: 800; margin: 0;">
                  <Bilingual en={st.titleEn} hi={st.titleHi} />
                </h3>
              </div>

              <div>
                {st.status === "COMPLETED" && (
                  <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 700; color: var(--green); background: rgba(0, 135, 62, 0.1); padding: 4px 10px; border-radius: 100px;">
                    <CheckCircle2 size={14} /> Completed
                  </span>
                )}
                {st.status === "ACTIVE" && (
                  <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 700; color: var(--saffron); background: rgba(245, 130, 32, 0.1); padding: 4px 10px; border-radius: 100px;">
                    <Clock size={14} /> Current Stage
                  </span>
                )}
                {st.status === "UPCOMING" && (
                  <span style="font-size: 12px; font-weight: 600; color: var(--muted); background: var(--paper); padding: 4px 10px; border-radius: 100px;">
                    Upcoming
                  </span>
                )}
              </div>
            </div>

            <p style="font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0;">
              <Bilingual en={st.descEn} hi={st.descHi} />
            </p>

            {st.status === "ACTIVE" && (
              <div style="margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <span style="font-size: 13px; font-weight: 600; color: var(--ink);">
                  Help Delhi cross the founding threshold:
                </span>
                <a href="/member/induction" class="button primary" style="font-size: 13px; padding: 6px 16px; display: inline-flex; align-items: center; gap: 6px;">
                  Complete Member Induction <ArrowRight size={14} />
                </a>
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
