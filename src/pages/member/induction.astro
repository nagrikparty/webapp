---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { InductionWizard } from "@/components/InductionWizard";
---

<BaseLayout
  title="Nagrik Party | Digital Induction"
  description="Complete the 10-step digital induction to apply for party membership."
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <nav class="member-nav" aria-label="Member dashboard sections">
        <a href="/member" class="member-nav-link" data-section="overview">
          <span class="member-nav-icon" aria-hidden="true">📋</span>
          <span>Overview</span>
        </a>
        <a href="/member/induction" class="member-nav-link is-active" data-section="induction">
          <span class="member-nav-icon" aria-hidden="true">🎓</span>
          <span>Digital Induction</span>
        </a>
        <a href="/member/membership-card" class="member-nav-link" data-section="card">
          <span class="member-nav-icon" aria-hidden="true">🪪</span>
          <span>Membership Card</span>
        </a>
        <a href="/member/documents" class="member-nav-link" data-section="vault">
          <span class="member-nav-icon" aria-hidden="true">📁</span>
          <span>Document Vault</span>
        </a>
        <a href="/member/contributions" class="member-nav-link" data-section="contributions">
          <span class="member-nav-icon" aria-hidden="true">💰</span>
          <span>Contributions</span>
        </a>
        <a href="/build-with-us" class="member-nav-link" data-section="build">
          <span class="member-nav-icon" aria-hidden="true">🛠️</span>
          <span>Build With Us</span>
        </a>
      </nav>
      <h1>Digital Membership Induction</h1>
      <p class="page-copy">
        A 10-step verified induction flow: personal details, electoral evidence, declarations, and consent.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <InductionWizard client:only="react" />
    </div>
  </section>
</BaseLayout>
