---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { MemberProfileView } from "@/components/MemberProfileView";
---

<BaseLayout
  title="Nagrik Party | My Profile"
  description="Manage your verified member profile."
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px;">
        <a href="/member" class="mini-label">Overview</a>
        <a href="/member/profile" class="mini-label" style="background: var(--ink); color: #fff;">My Profile</a>
        <a href="/member/membership-card" class="mini-label">Membership Card</a>
        <a href="/member/documents" class="mini-label">Document Vault</a>
      </div>
      <h1>Member Profile</h1>
      <p class="page-copy">
        Verified organizational member record details.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <MemberProfileView client:only="react" />
    </div>
  </section>
</BaseLayout>
