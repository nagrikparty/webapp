---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { MemberProfileView } from "@/components/MemberProfileView";
---

<BaseLayout
  title="Member Portal - Nagrik Party"
  description="Nagrik Party Formation Phase Member Portal."
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px;">
        <a href="/member" class="mini-label" style="background: var(--ink); color: #fff;">Overview</a>
        <a href="/member/induction" class="mini-label">Digital Induction</a>
        <a href="/member/membership-card" class="mini-label">Membership Card</a>
        <a href="/member/documents" class="mini-label">Document Vault</a>
      </div>
      <h1>
        <Bilingual en="Member Portal" hi="सदस्य पोर्टल" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Phase 1 — Formation Phase membership administration, verification, and digital record vault."
          hi="चरण 1 — गठन चरण सदस्यता प्रशासन, सत्यापन और डिजिटल रिकॉर्ड वॉल्ट।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <MemberProfileView client:only="react" />
    </div>
  </section>
</BaseLayout>
