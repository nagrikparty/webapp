---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { MemberDashboard } from "@/components/MemberDashboard";

export const prerender = false;
---

<BaseLayout
  title="Nagrik Party | Member Dashboard"
  description="Personal member space, verification status, digital card, and participation records."
>
  <section class="page-hero" style="padding-bottom: 20px;">
    <div class="container" style="max-width: 880px;">
      <nav class="member-nav" aria-label="Member dashboard sections">
        <a href="/member" class="member-nav-link is-active" data-section="overview">
          <span class="member-nav-icon" aria-hidden="true">📋</span>
          <span>Overview</span>
        </a>
        <a href="/member/induction" class="member-nav-link" data-section="induction">
          <span class="member-nav-icon" aria-hidden="true">🎓</span>
          <span>Digital Induction</span>
        </a>
        <a href="/member/membership-card" class="member-nav-link" data-section="card">
          <span class="member-nav-icon" aria-hidden="true">🪪</span>
          <span>Membership Card</span>
        </a>
        <a href="/member/documents" class="member-nav-link" data-section="vault">
          <span class="member-nav-icon" aria-hidden="true">📁</span>
          <span>Document Vault</span>
        </a>
        <a href="/member/contributions" class="member-nav-link" data-section="contributions">
          <span class="member-nav-icon" aria-hidden="true">💰</span>
          <span>Contributions</span>
        </a>
        <a href="/build-with-us" class="member-nav-link" data-section="build">
          <span class="member-nav-icon" aria-hidden="true">🛠️</span>
          <span>Build With Us</span>
        </a>
      </nav>
      <h1 style="font-size: clamp(1.85rem, 3.5vw, 2.6rem); font-family: var(--font-serif); margin: 4px 0 8px;">
        My Nagrik Dashboard
      </h1>
      <p style="font-size: 14.5px; color: var(--muted); margin: 0; line-height: 1.55;">
        Phase 1, Formation Phase personal membership space, verified records, and volunteer participation.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 16px; padding-bottom: 60px;">
    <div class="container" style="max-width: 880px;">
      <MemberDashboard client:only="react" />
    </div>
  </section>
</BaseLayout>
