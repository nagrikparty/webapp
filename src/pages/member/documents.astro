---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { MemberDocumentVault } from "@/components/MemberDocumentVault";
---

<BaseLayout
  title="Document Vault - Nagrik Party"
  description="Encrypted private storage for your identity documents and affidavits."
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px;">
        <a href="/member" class="mini-label">Overview</a>
        <a href="/member/induction" class="mini-label">Digital Induction</a>
        <a href="/member/membership-card" class="mini-label">Membership Card</a>
        <a href="/member/documents" class="mini-label" style="background: var(--ink); color: #fff;">Document Vault</a>
      </div>
      <h1>
        <Bilingual en="Document Vault" hi="दस्तावेज़ वॉल्ट" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Encrypted digital vault for verified member documents, declarations, and proof records."
          hi="सत्यापित सदस्य दस्तावेजों, घोषणाओं और प्रमाण रिकॉर्ड के लिए एन्क्रिप्टेड डिजिटल वॉल्ट।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <MemberDocumentVault client:only="react" />
    </div>
  </section>
</BaseLayout>
