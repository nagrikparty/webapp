---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { IssueReporter } from "@/components/IssueReporter";
import { IssuesList } from "@/components/IssuesList";
---

<BaseLayout
  title="Report an Issue | Nagrik Party"
  description="Report civic problems in your Delhi locality. Your identity stays private. Only the work is public."
>
  <section class="page-hero">
    <div class="container">
      <h1>Report an Issue</h1>
      <p class="page-copy">
        Citizens submit local problems. Volunteers verify and classify. Nagrik Party files official complaints through lawful channels. If unresolved, the issue becomes an area manifesto commitment.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2 style="margin: 0 0 16px; font-size: 28px;">Submit a civic issue</h2>
          <p style="color: var(--muted); line-height: 1.6; margin-bottom: 18px;">
            Your name, email, and personal identity will never appear on public issue pages. Only the issue details, location, category, and status are shown publicly.
          </p>
          <div class="notice">
            <strong>Issue statuses:</strong>
            <br />
            Submitted &rarr; Verified &rarr; Complaint filed &rarr; Escalated &rarr; Unresolved &rarr; Added to area manifesto &rarr; Resolved
          </div>
        </div>
        <IssueReporter client:load />
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="section-head">
        <h2>Reported issues</h2>
        <p>Public view: complainant identity is never shown.</p>
      </div>
      <IssuesList client:load />
    </div>
  </section>
</BaseLayout>
