---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { AdminMembersView } from "@/components/AdminMembersView";
---

<BaseLayout
  title="Founding Members Register - Nagrik Party"
  description="Master register of approved members of Nagrik Party"
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
        <a href="/admin" class="mini-label">Overview</a>
        <a href="/admin/applications" class="mini-label">Applications</a>
        <a href="/admin/verifications" class="mini-label">Verifications Desk</a>
        <a href="/admin/members" class="mini-label" style="background: var(--ink); color: #fff;">Members</a>
        <a href="/admin/cards" class="mini-label">Card Console</a>
        <a href="/admin/exports" class="mini-label">Submission Exports</a>
        <a href="/admin/finance" class="mini-label">Finance</a>
        <a href="/admin/audit" class="mini-label">Audit Trail</a>
        <a href="/admin/settings" class="mini-label">Settings</a>
      </div>
      <h1>
        <Bilingual en="Master Member Register" hi="मुख्य सदस्य रजिस्टर" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Verified founding membership register with statutory traceability and digital card references."
          hi="वैधानिक पता लगाने की क्षमता और डिजिटल कार्ड संदर्भों के साथ सत्यापित संस्थापक सदस्यता रजिस्टर।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <AdminMembersView client:only="react" />
    </div>
  </section>
</BaseLayout>
