---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { AdminCardsView } from "@/components/AdminCardsView";
---

<BaseLayout
  title="Card Issuance Console - Nagrik Party"
  description="Manage membership card issuance, revocation, and reissuance."
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
        <a href="/admin" class="mini-label">Overview</a>
        <a href="/admin/applications" class="mini-label">Applications</a>
        <a href="/admin/verifications" class="mini-label">Verifications Desk</a>
        <a href="/admin/members" class="mini-label">Members</a>
        <a href="/admin/cards" class="mini-label" style="background: var(--ink); color: #fff;">Card Console</a>
        <a href="/admin/exports" class="mini-label">Submission Exports</a>
        <a href="/admin/finance" class="mini-label">Finance</a>
        <a href="/admin/audit" class="mini-label">Audit Trail</a>
        <a href="/admin/settings" class="mini-label">Settings</a>
      </div>
      <h1>
        <Bilingual en="Card Issuance Console" hi="कार्ड जारी करने का कंसोल" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Manage CR80 membership card generation, issuance, revocation, and reissuance for all approved members."
          hi="सभी अनुमोदित सदस्यों के लिए CR80 सदस्यता कार्ड जारी करने, निरस्तीकरण और पुनः जारी करने का प्रबंधन करें।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <AdminCardsView client:only="react" />
    </div>
  </section>
</BaseLayout>
