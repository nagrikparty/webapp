---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { AdminAuditView } from "@/components/AdminAuditView";
---

<BaseLayout
  title="Audit Trail - Nagrik Party"
  description="Immutable administrative and statutory audit trail"
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
        <a href="/admin" class="mini-label">Overview</a>
        <a href="/admin/applications" class="mini-label">Applications</a>
        <a href="/admin/verifications" class="mini-label">Verifications Desk</a>
        <a href="/admin/members" class="mini-label">Members</a>
        <a href="/admin/cards" class="mini-label">Card Console</a>
        <a href="/admin/exports" class="mini-label">Submission Exports</a>
        <a href="/admin/finance" class="mini-label">Finance</a>
        <a href="/admin/audit" class="mini-label" style="background: var(--ink); color: #fff;">Audit Trail</a>
        <a href="/admin/settings" class="mini-label">Settings</a>
      </div>
      <h1>
        <Bilingual en="Administrative Audit Log" hi="प्रशासनिक ऑडिट लॉग" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Cryptographic audit log recording every membership approval, rejection, and submission export generation."
          hi="प्रत्येक सदस्यता स्वीकृति, अस्वीकृति और प्रस्तुति निर्यात उत्पादन को रिकॉर्ड करने वाला क्रिप्टोग्राफ़िक ऑडिट लॉग।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <AdminAuditView client:only="react" />
    </div>
  </section>
</BaseLayout>
