---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { PublicDocumentsLibrary } from "@/components/PublicDocumentsLibrary";
---

<BaseLayout
  title="Public Documents Library Management - Nagrik Party"
  description="Manage and publish foundational charters, constitutional declarations, and financial reports."
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
        <a href="/admin" class="mini-label">Overview</a>
        <a href="/admin/applications" class="mini-label">Applications</a>
        <a href="/admin/verifications" class="mini-label">Verifications Desk</a>
        <a href="/admin/documents" class="mini-label">Documents</a>
        <a href="/admin/documents-library" class="mini-label" style="background: var(--ink); color: #fff;">Charters Library</a>
        <a href="/admin/members" class="mini-label">Members</a>
        <a href="/admin/cards" class="mini-label">Card Console</a>
        <a href="/admin/exports" class="mini-label">Submission Exports</a>
        <a href="/admin/finance" class="mini-label">Finance</a>
        <a href="/admin/audit" class="mini-label">Audit Trail</a>
        <a href="/admin/settings" class="mini-label">Settings</a>
      </div>
      <h1>
        <Bilingual en="Public Charters & Document Management" hi="सार्वजनिक चार्टर और दस्तावेज़ प्रबंधन" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Statutory repository of 24 foundational party charters, constitution, and financial transparency declarations."
          hi="24 मूलभूत पार्टी चार्टर, संविधान और वित्तीय पारदर्शिता घोषणाओं का वैधानिक भंडार।"
        />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <PublicDocumentsLibrary client:only="react" />
    </div>
  </section>
</BaseLayout>
