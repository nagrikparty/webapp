---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminApplicationsView } from "@/components/AdminApplicationsView";
---

<BaseLayout
  title="Nagrik Party | Application Intake Queue"
  description="Review and manage incoming membership applications."
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container">
      <div style="display: flex; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
        <a href="/admin" class="mini-label">Overview</a>
        <a href="/admin/applications" class="mini-label" style="background: var(--ink); color: #fff;">Applications</a>
        <a href="/admin/verifications" class="mini-label">Verifications Desk</a>
        <a href="/admin/members" class="mini-label">Members</a>
        <a href="/admin/cards" class="mini-label">Card Console</a>
        <a href="/admin/exports" class="mini-label">Submission Exports</a>
        <a href="/admin/finance" class="mini-label">Finance</a>
        <a href="/admin/audit" class="mini-label">Audit Trail</a>
        <a href="/admin/settings" class="mini-label">Settings</a>
      </div>
      <h1>Application Intake Queue</h1>
      <p class="page-copy">
        All incoming membership applications awaiting initial review and document scrutiny.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px;">
    <div class="container">
      <AdminApplicationsView client:only="react" />
    </div>
  </section>
</BaseLayout>
