---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import { AdminOverview } from "@/components/AdminOverview";

export const prerender = false;
---

<BaseLayout
  title="Nagrik Party | Executive Command Hub"
  description="Nagrik Party Executive Administration & Scrutiny Portal"
>
  <section class="page-hero" style="padding-bottom: 16px;">
    <div class="container">
      <AdminNav activeSection="overview" />
      <h1>Party Administration</h1>
      <p class="page-copy">
        Central governance portal for Phase 1 formation oversight, document scrutiny, and statutory compliance.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 8px; padding-bottom: 48px;">
    <div class="container">
      <AdminOverview client:only="react" />
    </div>
  </section>
</BaseLayout>
