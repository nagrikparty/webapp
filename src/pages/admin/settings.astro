---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminNav from "@/components/admin/AdminNav.astro";
import { AdminSettingsHub } from "@/components/admin/AdminSettingsHub";

export const prerender = false;
---

<BaseLayout
  title="Nagrik Party | System & Security Hub"
  description="System configuration, staff role management, and statutory audit trail."
>
  <section class="page-hero" style="padding-bottom: 16px;">
    <div class="container">
      <AdminNav activeSection="settings" />
      <h1>System & Security Hub</h1>
      <p class="page-copy">
        Administrative parameters, formation phase controls, staff security privileges, and chronological statutory audit logs.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 8px; padding-bottom: 48px;">
    <div class="container">
      <AdminSettingsHub client:only="react" />
    </div>
  </section>
</BaseLayout>
