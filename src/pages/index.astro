---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { ManifestoVoting } from "@/components/ManifestoVoting";
import { CrimeDashboard } from "@/components/CrimeDashboard";
import { delhiAreas } from "@/lib/content";
import { ShieldCheck, FileText, Scale, Landmark } from "lucide-react";

export const prerender = false;
---

<BaseLayout
  title="Nagrik Party — Formation Phase | Kaam dikhna chahiye"
  description="An independent political initiative working toward the formation and registration of a political party under Section 29A RPA 1951."
>
  <!-- First Viewport Hero: Institutional Civic Header -->
  <section class="page-hero" style="padding-top: 48px; padding-bottom: 40px; border-bottom: 1px solid var(--line); background: #ffffff;">
    <div class="container" style="max-width: 1080px;">
      
      <!-- Phase 1 Formation Badge -->
      <div style="margin-bottom: 20px;">
        <span class="civic-hero-badge">
          PHASE 1 • FORMATION PHASE
        </span>
      </div>

      <!-- Main Slogan & Title -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 32px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 320px;">
          <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 900; letter-spacing: -0.03em; color: var(--ink); margin: 0 0 16px; line-height: 1.08;">
            Nagrik Party
          </h1>

          <div style="display: inline-block; background: #fff8f0; border-left: 3px solid var(--saffron); padding: 8px 16px; border-radius: 0 8px 8px 0; margin-bottom: 20px;">
            <span style="font-size: 18px; font-weight: 800; color: #b45309; font-family: 'Yantramanav', sans-serif;">
              काम दिखना चाहिए
            </span>
            <span style="font-size: 13px; color: var(--muted); margin-left: 8px; font-weight: 500;">
              • Governance before power
            </span>
          </div>

          <p style="font-size: clamp(16px, 2vw, 19px); color: #374151; line-height: 1.55; margin: 0 0 28px; max-width: 680px; font-weight: 400;">
            <strong>Nagrik Party — Formation Phase: An independent political initiative working toward the formation and registration of a political party.</strong>
            Building a verifiable, citizen-driven public accountability system across Delhi's 70 Assembly constituencies.
          </p>

          <!-- Primary & Secondary Action Cluster -->
          <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
            <a href="/membership" class="button button-primary" style="padding: 12px 28px; font-size: 15px; font-weight: 700; background: var(--saffron); border-color: var(--saffron); color: #fff; box-shadow: 0 4px 16px rgba(245, 130, 32, 0.25);">
              <Bilingual en="Become a Member" hi="सदस्य बनें" /> &rarr;
            </a>
            <a href="/crime" class="button" style="padding: 12px 22px; font-size: 14px; font-weight: 600;">
              <Bilingual en="Explore Our Work" hi="हमारा काम देखें" />
            </a>
            <a href="/transparency" class="button" style="padding: 12px 22px; font-size: 14px; font-weight: 600;">
              <Bilingual en="View Transparency" hi="पारदर्शिता" />
            </a>
            <a href="/documents" class="button" style="padding: 12px 22px; font-size: 14px; font-weight: 600;">
              <Bilingual en="Read the Constitution" hi="संविधान पढ़ें" />
            </a>
          </div>
        </div>

        <!-- Stage 3 Live Status Card -->
        <div style="width: 320px; background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <span style="font-size: 11px; font-weight: 800; color: var(--saffron); text-transform: uppercase; letter-spacing: 0.05em;">
              Formation Roadmap
            </span>
            <span style="font-size: 11px; font-weight: 700; background: rgba(0, 135, 62, 0.1); color: var(--green); padding: 2px 8px; border-radius: 9999px;">
              Stage 3 Active
            </span>
          </div>

          <h3 style="font-size: 16px; font-weight: 800; color: var(--ink); margin: 0 0 8px;">
            Founding Member Induction
          </h3>
          <p style="font-size: 12px; color: var(--muted); line-height: 1.5; margin: 0 0 16px;">
            Currently enrolling 100+ verified voter members with valid EPIC IDs across Delhi to fulfill Section 29A RPA 1951 statutory criteria.
          </p>

          <div style="border-top: 1px solid var(--line); padding-top: 12px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 12px; font-weight: 600; color: var(--ink);">
              9-Stage Process
            </span>
            <a href="/formation-progress" style="font-size: 12px; font-weight: 700; color: var(--saffron); text-decoration: none;">
              Track Roadmap &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Institutional Metrics Bar -->
  <section style="background: #fafafa; border-bottom: 1px solid var(--line); padding: 20px 0;">
    <div class="container" style="max-width: 1080px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(0, 135, 62, 0.1); display: flex; align-items: center; justify-content: center; color: var(--green); flex-shrink: 0;">
            <ShieldCheck size={20} />
          </div>
          <div>
            <div style="font-size: 18px; font-weight: 800; color: var(--ink);">Zero Cash</div>
            <div style="font-size: 12px; color: var(--muted);">100% Cashless Ledger</div>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(245, 130, 32, 0.1); display: flex; align-items: center; justify-content: center; color: var(--saffron); flex-shrink: 0;">
            <Landmark size={20} />
          </div>
          <div>
            <div style="font-size: 18px; font-weight: 800; color: var(--ink);">70 Constituencies</div>
            <div style="font-size: 12px; color: var(--muted);">Delhi-Wide Roll Mapping</div>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(220, 38, 38, 0.1); display: flex; align-items: center; justify-content: center; color: #dc2626; flex-shrink: 0;">
            <Scale size={20} />
          </div>
          <div>
            <div style="font-size: 18px; font-weight: 800; color: var(--ink);">Real Citations</div>
            <div style="font-size: 12px; color: var(--muted);">Verified Crime Tracker</div>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(0, 102, 204, 0.1); display: flex; align-items: center; justify-content: center; color: #0066cc; flex-shrink: 0;">
            <FileText size={20} />
          </div>
          <div>
            <div style="font-size: 18px; font-weight: 800; color: var(--ink);">SHA-256 Hashes</div>
            <div style="font-size: 12px; color: var(--muted);">Open Public Charters</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Verified Crime Tracker Elevation -->
  <section class="section" style="padding-top: 40px; padding-bottom: 24px;">
    <div class="container" style="max-width: 1080px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
        <div>
          <div class="mini-label" style="background: rgba(220, 38, 38, 0.1); color: #dc2626;">
            Civic Accountability & Evidence
          </div>
          <h2 style="font-size: 24px; font-weight: 800; margin: 4px 0 0;">
            <Bilingual en="Verified Crime Tracker" hi="सत्यापित अपराध ट्रैकर" />
          </h2>
          <p style="font-size: 14px; color: var(--muted); margin: 4px 0 0;">
            Publicly documented offenses in Delhi NCR, verified against published news reports.
          </p>
        </div>
        <a href="/crime" class="button" style="font-size: 13px; font-weight: 700; color: #dc2626; border-color: #dc2626;">
          Open Full Tracker & Citations &rarr;
        </a>
      </div>

      <CrimeDashboard client:only="react" />
    </div>
  </section>

  <!-- Section 3: The Civic Lifecycle -->
  <section class="section band-soft" style="padding-top: 48px; padding-bottom: 48px;">
    <div class="container" style="max-width: 1080px;">
      <div class="section-head" style="margin-bottom: 36px;">
        <div class="mini-label">The Civic Operating Doctrine</div>
        <h2 style="font-size: 28px; font-weight: 800;">
          <Bilingual en="How Public Grievance Tracking Works" hi="नागरिक शिकायत समाधान प्रक्रिया" />
        </h2>
        <p style="max-width: 680px; margin: 0 auto; color: var(--muted); font-size: 15px;">
          <Bilingual
            en="From the moment a citizen identifies an issue to its resolution or elevation into our living manifesto."
            hi="नागरिक द्वारा मुद्दा रिपोर्ट करने से लेकर उसके समाधान या घोषणापत्र में शामिल होने तक की प्रक्रिया।"
          />
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px;">
        <div class="card" style="background: #fff; padding: 24px; border-radius: 14px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; margin-bottom: 16px;">
            1
          </div>
          <h3 style="font-size: 16px; font-weight: 800; margin: 0 0 8px;">Citizen Reports Issue</h3>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0;">
            Upload photo, location, and description. Complainant identity is strictly protected and never shown on public pages.
          </p>
        </div>

        <div class="card" style="background: #fff; padding: 24px; border-radius: 14px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--saffron); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; margin-bottom: 16px;">
            2
          </div>
          <h3 style="font-size: 16px; font-weight: 800; margin: 0 0 8px;">Volunteer Verifies</h3>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0;">
            Ground check by local coordinators, ward classification, and verification against Delhi governance standards.
          </p>
        </div>

        <div class="card" style="background: #fff; padding: 24px; border-radius: 14px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: #0066cc; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; margin-bottom: 16px;">
            3
          </div>
          <h3 style="font-size: 16px; font-weight: 800; margin: 0 0 8px;">Official Complaint Filed</h3>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0;">
            Lawful submission to municipal and state departments with tracking numbers, dates, and response logs.
          </p>
        </div>

        <div class="card" style="background: #fff; padding: 24px; border-radius: 14px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--green); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; margin-bottom: 16px;">
            4
          </div>
          <h3 style="font-size: 16px; font-weight: 800; margin: 0 0 8px;">Manifesto Commitment</h3>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0;">
            If authorities leave the issue unresolved, it is codified as an official constituency manifesto priority.
          </p>
        </div>
      </div>
      
      <div style="text-align: center; margin-top: 24px;">
        <a href="/issues" class="button" style="font-size: 13px; font-weight: 700;">
          View Public Issues & Escalate &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Section 4: Living Manifesto Priorities -->
  <section class="section" style="padding-top: 48px; padding-bottom: 48px;">
    <div class="container" style="max-width: 1080px;">
      <div class="section-head">
        <div class="mini-label">Direct Democratic Consultation</div>
        <h2 style="font-size: 28px; font-weight: 800;">
          <Bilingual en="Living Manifesto Priorities" hi="घोषणापत्र प्राथमिकताएं" />
        </h2>
        <p style="max-width: 680px; margin: 0 auto; color: var(--muted); font-size: 15px;">
          <Bilingual
            en="Supporters and verified members vote on top issues to shape our legislative program. Kaam dikhna chahiye."
            hi="समर्थक और सदस्य प्राथमिक मुद्दों पर मतदान करते हैं। काम दिखना चाहिए।"
          />
        </p>
      </div>
      <ManifestoVoting client:load />
    </div>
  </section>

  <!-- Section 5: Public Charters & Transparency Preview -->
  <section class="section band-white" style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="container" style="max-width: 1080px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px; flex-wrap: wrap; gap: 12px;">
        <div>
          <div class="mini-label">Governance & Legal Foundations</div>
          <h2 style="font-size: 24px; font-weight: 800; margin: 4px 0 0;">
            <Bilingual en="Public Documents & Charters" hi="सार्वजनिक दस्तावेज़ और घोषणापत्र" />
          </h2>
          <p style="font-size: 14px; color: var(--muted); margin: 4px 0 0;">
            Auditable foundational charters, draft constitution, and compliance records with SHA-256 integrity verification.
          </p>
        </div>
        <a href="/documents" class="button" style="font-size: 13px; font-weight: 700;">
          Open Document Archive &rarr;
        </a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px;">
        <div class="card" style="padding: 22px; background: #fff; border: 1px solid var(--line); border-radius: 14px;">
          <span style="font-size: 11px; font-weight: 800; color: var(--saffron); text-transform: uppercase;">GOVERNANCE</span>
          <h4 style="font-size: 16px; font-weight: 800; margin: 8px 0 6px;">Draft Constitution of Nagrik Party</h4>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0 0 14px;">
            Inner-party democracy, non-violence pledge, allegiance to Constitution of India, and executive elections.
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="badge-citation">v1.0 • SHA-256</span>
            <a href="/legal/constitution" style="font-size: 13px; font-weight: 700; color: var(--saffron); text-decoration: none;">Read &rarr;</a>
          </div>
        </div>

        <div class="card" style="padding: 22px; background: #fff; border: 1px solid var(--line); border-radius: 14px;">
          <span style="font-size: 11px; font-weight: 800; color: var(--green); text-transform: uppercase;">FINANCE</span>
          <h4 style="font-size: 16px; font-weight: 800; margin: 8px 0 6px;">Zero-Cash Transparency Framework</h4>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0 0 14px;">
            100% digital bank accounts, zero cash accepted, public monthly contribution lists, and annual audit disclosure.
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="badge-citation">Audited • Public</span>
            <a href="/transparency" style="font-size: 13px; font-weight: 700; color: var(--green); text-decoration: none;">Inspect &rarr;</a>
          </div>
        </div>

        <div class="card" style="padding: 22px; background: #fff; border: 1px solid var(--line); border-radius: 14px;">
          <span style="font-size: 11px; font-weight: 800; color: #0066cc; text-transform: uppercase;">STATUTORY</span>
          <h4 style="font-size: 16px; font-weight: 800; margin: 8px 0 6px;">RPA 1951 Section 29A Dossier</h4>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0 0 14px;">
            Continuous page-numbered submission framework preparing the official registration dossier for Nirvachan Sadan.
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="badge-citation">Stage 3 &rarr; 7</span>
            <a href="/formation-progress" style="font-size: 13px; font-weight: 700; color: #0066cc; text-decoration: none;">Roadmap &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Delhi 70 AC Ground Coverage -->
  <section class="section" id="coverage" style="padding-top: 48px; padding-bottom: 48px;">
    <div class="container" style="max-width: 1080px;">
      <div class="section-head">
        <div class="mini-label">Constituency Network</div>
        <h2 style="font-size: 28px; font-weight: 800;">
          <Bilingual en="Delhi 70 Assembly Constituencies" hi="दिल्ली 70 विधानसभा क्षेत्र" />
        </h2>
        <p style="max-width: 680px; margin: 0 auto; color: var(--muted); font-size: 15px;">
          <Bilingual
            en="Founding membership induction and civic issue tracking active across all 70 constituencies."
            hi="सभी 70 विधानसभा क्षेत्रों में संस्थापक सदस्यता प्रेरण और नागरिक समस्या ट्रैकिंग जारी।"
          />
        </p>
      </div>

      <div class="map-strip" style="max-height: 240px; overflow-y: auto; padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: 14px;">
        {delhiAreas.map((area) => (
          <div class="area-chip" style="font-size: 12px; padding: 6px 12px;">
            <strong>{area}</strong>
            <span style="font-size: 10px; color: var(--muted);">Delhi AC</span>
          </div>
        ))}
      </div>

      <div style="margin-top: 24px; text-align: center;">
        <a href="/membership" class="button button-primary" style="padding: 10px 24px; font-size: 14px; font-weight: 700;">
          Join Induction in Your Constituency &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
