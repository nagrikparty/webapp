          </p>
          <a href="/issues" style="font-size: 13px; font-weight: 600; color: var(--saffron); text-decoration: none;">
            Browse Issues &rarr;
          </a>
        </div>

        <div class="card" style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: 22px;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
            <TrendingUp size={18} style={{ color: "var(--blue)" }} />
            <h3 style="font-size: 16px; font-weight: 700; margin: 0; font-family: var(--font-serif);">
