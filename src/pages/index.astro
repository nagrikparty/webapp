      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 9: BUILD WITH US
       ========================================================================= -->
  <section class="section" style="padding-top: 48px; padding-bottom: 48px;">
    <div class="container" style="max-width: 1080px;">
      <div
        class="card"
        style="background: var(--paper-card); border: 1px solid var(--line-strong); border-radius: 4px; padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow-elevated);"
      >
        <div style="max-width: 700px; margin-bottom: 24px;">
          <div class="mini-label" style="background: rgba(179, 74, 21, 0.08); color: var(--saffron);">
