  <section class="section band-soft" style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="container" style="max-width: 1080px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div>
          <div class="mini-label" style="background: rgba(29, 86, 53, 0.08); color: var(--green);">
            Radical Transparency
          </div>
          <h2 style="font-size: 24px; font-weight: 700; font-family: var(--font-serif); margin: 4px 0 0;">
            Public Charters & Financial Ledger
          </h2>
          <p style="font-size: 14px; color: var(--muted); margin: 4px 0 0;">
            100% digital bank accounts, zero cash accepted, and SHA-256 verifiable legal documents.
          </p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px;">
        <div class="card" style="padding: 22px; background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px;">
          <span style="font-size: 11px; font-weight: 700; color: var(--saffron); text-transform: uppercase; font-family: var(--font-mono);">GOVERNANCE</span>
          <h3 style="font-size: 16px; font-weight: 700; margin: 8px 0 6px; font-family: var(--font-serif);">Draft Constitution</h3>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0 0 14px;">
            Inner-party democracy, non-violence pledge, and allegiance to the Constitution of India.
          </p>
          <a href="/legal/constitution" style="font-size: 13px; font-weight: 600; color: var(--saffron); text-decoration: none;">
            Read Constitution &rarr;
          </a>
        </div>

        <div class="card" style="padding: 22px; background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px;">
          <span style="font-size: 11px; font-weight: 700; color: var(--green); text-transform: uppercase; font-family: var(--font-mono);">FINANCE</span>
          <h3 style="font-size: 16px; font-weight: 700; margin: 8px 0 6px; font-family: var(--font-serif);">Cashless Accounts Ledger</h3>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0 0 14px;">
            Published formation-stage financial receipts and expenditures with full source provenance.
          </p>
          <a href="/transparency" style="font-size: 13px; font-weight: 600; color: var(--green); text-decoration: none;">
            Inspect Ledger &rarr;
          </a>
        </div>

        <div class="card" style="padding: 22px; background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px;">
          <span style="font-size: 11px; font-weight: 700; color: var(--blue); text-transform: uppercase; font-family: var(--font-mono);">STATUTORY</span>
          <h3 style="font-size: 16px; font-weight: 700; margin: 8px 0 6px; font-family: var(--font-serif);">Section 29A Dossier Vault</h3>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0 0 14px;">
            Continuous page-numbered regulatory dossier for submission to Nirvachan Sadan.
          </p>
          <a href="/documents" style="font-size: 13px; font-weight: 600; color: var(--blue); text-decoration: none;">
            Open Document Vault &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 11: FORMATION ROADMAP
       ========================================================================= -->
  <section class="section" style="padding-top: 48px; padding-bottom: 48px;">
    <div class="container" style="max-width: 900px;">
      <div class="section-head" style="margin-bottom: 28px;">
        <div class="mini-label">Roadmap</div>
        <h2 style="font-size: 26px; font-weight: 700; font-family: var(--font-serif);">
          The 9-Stage Formation Journey
        </h2>
        <p style="max-width: 640px; margin: 0 auto; color: var(--muted); font-size: 14.5px;">
          Auditable progress toward registration under Section 29A RPA 1951.
        </p>
      </div>

      <div style="display: grid; gap: 12px;">
        {progressData.milestones.slice(0, 5).map((st) => (
          <div
            class="card"
            style={{
              background: "var(--paper-card)",
              borderRadius: "4px",
              padding: "16px 20px",
              border: st.status === "IN_PROGRESS" ? "1.5px solid var(--saffron)" : "1px solid var(--line)",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              flexWrap: "wrap",
              gap: "12px",
            }}
          >
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                <span
                  style={{
                    fontFamily: "var(--font-mono)",
                    fontSize: "10.5px",
                    fontWeight: 700,
                    padding: "2px 6px",
                    borderRadius: "2px",
                    background: st.status === "COMPLETED" ? "rgba(29, 86, 53, 0.1)" : st.status === "IN_PROGRESS" ? "rgba(179, 74, 21, 0.1)" : "var(--paper-subtle)",
                    color: st.status === "COMPLETED" ? "var(--green)" : st.status === "IN_PROGRESS" ? "var(--saffron)" : "var(--muted)",
                  }}
                >
                  Stage {st.sort_order}
                </span>
                <span style="font-size: 11px; color: var(--muted); font-family: var(--font-mono); text-transform: uppercase;">
                  {st.category}
                </span>
              </div>
              <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: var(--ink);">
                {st.title}
              </h3>
            </div>

            <div style="font-size: 12.5px; font-weight: 600; color: st.status === 'COMPLETED' ? 'var(--green)' : st.status === 'IN_PROGRESS' ? 'var(--saffron)' : 'var(--muted)';">
              {st.status === "COMPLETED" ? "Completed" : st.status === "IN_PROGRESS" ? "Active Stage" : "Upcoming"}
            </div>
          </div>
        ))}
      </div>

      <div style="text-align: center; margin-top: 20px;">
        <a href="/formation-progress" class="button" style="font-size: 13.5px; font-weight: 600;">
          View Full 9-Stage Roadmap &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
