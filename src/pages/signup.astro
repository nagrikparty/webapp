---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { AuthFlow } from "@/components/AuthFlow";
---

<BaseLayout
  title="Sign Up | Nagrik Party"
  description="Create your Nagrik Party account."
  bodyClass="auth-page"
>
  <section class="page-hero" style="padding-bottom: 12px; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <h1 style="margin: 0 auto; font-family: var(--font-serif); font-weight: 700; font-size: clamp(28px, 5vw, 38px); letter-spacing: -0.02em; color: var(--ink);">
        <Bilingual en="Sign Up" hi="साइन अप करें" />
      </h1>
      <p style="color: var(--muted); font-size: 14.5px; margin: 8px auto 0; max-width: 480px;">
        <Bilingual en="Create an account to begin your Phase 1 digital membership induction." hi="चरण 1 डिजिटल सदस्यता इंडक्शन शुरू करने के लिए खाता बनाएं।" />
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px; padding-bottom: 48px; min-height: 55vh; position: relative; z-index: 10;">
    <div class="container">
      <AuthFlow client:load initialMode="signup" />
    </div>
  </section>
</BaseLayout>
