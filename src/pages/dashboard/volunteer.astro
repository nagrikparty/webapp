---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { VolunteerDashboard } from "@/components/VolunteerDashboard";
---

<BaseLayout
  title="Nagrik Party | Volunteer Dashboard"
  description="Internal dashboard for volunteers and supporters."
>
  <section class="page-hero">
    <div class="container">
      <h1>Volunteer Portal</h1>
      <p class="page-copy">
        Welcome to your volunteer dashboard. Here you can find digital tasks, verify issues, and coordinate local outreach.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div>
        <VolunteerDashboard client:only="react" />
      </div>
    </div>
  </section>
</BaseLayout>
