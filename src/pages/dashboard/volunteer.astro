---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
import { VolunteerDashboard } from "@/components/VolunteerDashboard";
---

<BaseLayout
  title="Volunteer Dashboard - Nagrik Party"
  description="Internal dashboard for volunteers and supporters."
>
  <section class="page-hero">
    <div class="container">
      <h1>
        <Bilingual en="Volunteer Portal" hi="स्वयंसेवक पोर्टल" />
      </h1>
      <p class="page-copy">
        <Bilingual 
          en="Welcome to your volunteer dashboard. Here you can find digital tasks, verify issues, and coordinate local outreach." 
          hi="आपके स्वयंसेवक डैशबोर्ड में स्वागत है। यहां आप डिजिटल कार्य पा सकते हैं, मुद्दों का सत्यापन कर सकते हैं, और स्थानीय आउटरीच का समन्वय कर सकते हैं।" 
        />
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div>
        <VolunteerDashboard client:only="react" />
      </div>
    </div>
  </section>
</BaseLayout>
