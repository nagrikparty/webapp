---
import BaseLayout from "@/layouts/BaseLayout.astro";

Astro.cookies.delete("sb-access-token", { path: "/" });
Astro.cookies.delete("sb-refresh-token", { path: "/" });
---

<BaseLayout title="Nagrik Party | Logging Out" description="Logging out of your account.">
  <div class="page-offset" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; padding-bottom: 40px; padding-left: 16px; padding-right: 16px;">
    <div class="card" style="max-width: 420px; padding: 32px 24px; background: var(--paper-card); border-radius: 4px; border: 1px solid var(--line-strong);">
      <h2 style="font-family: var(--font-serif); font-weight: 700; margin-bottom: 8px;">
        Signing Out...
      </h2>
      <p style="color: var(--muted); font-size: 14px; margin-bottom: 20px;">
        Clearing your session securely.
      </p>
      <div id="logout-spinner" style="font-size: 13px; color: var(--muted); font-family: var(--font-mono);">
        Redirecting to login...
      </div>
    </div>
  </div>

  <script>
    import { supabase } from "@/lib/supabase";

    async function handleSignOut() {
      try {
        if (supabase) {
          await supabase.auth.signOut();
        }
        for (const key of Object.keys(localStorage)) {
          if (key.startsWith("sb-")) {
            localStorage.removeItem(key);
          }
        }
      } catch (err) {
        console.error("Sign out error:", err);
      } finally {
        window.location.href = "/login";
      }
    }

    handleSignOut();
  </script>
</BaseLayout>
