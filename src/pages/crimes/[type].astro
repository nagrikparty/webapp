---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;

const { type } = Astro.params;
if (!type) {
  return Astro.redirect('/crime');
}

const fallbackType = type.charAt(0).toUpperCase() + type.slice(1).toLowerCase();

import { supabase } from "@/lib/supabase";

// Fetch data directly from DB to avoid SSR fetch issues
const { data: rawIncidents } = supabase 
  ? await supabase
      .from('crimes')
      .select('*')
      .ilike('crime_type', type)
      .order('incident_date', { ascending: false })
  : { data: [] };
const incidents = rawIncidents ?? [];
const dbType = incidents.length > 0 ? incidents[0].crime_type : fallbackType;
---

<BaseLayout
  title={`Nagrik Party | ${dbType} Citations`}
  description={`Verified news citations for reported ${dbType} incidents in Delhi.`}
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container" style="max-width: 900px;">
      <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
        <a href="/crime" style="display: inline-flex; align-items: center; gap: 4px; font-size: 13px; color: var(--muted); text-decoration: none; font-weight: 600;">
          &larr; Verified Crime Tracker
        </a>
      </div>

      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 8px; flex-wrap: wrap;">
        <h1 style="margin: 0; font-size: 28px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-family: var(--font-serif);">
          {dbType}
        </h1>
        <span class="badge-verified" style="border-radius: 2px; border: 1px dashed var(--red);">
          {incidents.length} Verified Citations
        </span>
      </div>

      <p class="page-copy" style="margin: 0;">
        Every incident listed below is verified and directly linked to a public news article or official report. Zero statistical estimates.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px; min-height: 60vh;">
    <div class="container" style="max-width: 900px;">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        {incidents.length === 0 ? (
          <div class="card" style="text-align: center; padding: 48px 24px; background: var(--paper-card); border-radius: 4px; border: 1px dashed var(--line); box-shadow: var(--shadow);">
            <p style="color: var(--muted); margin: 0; font-size: 14px;">No verified citations found for this category yet.</p>
          </div>
        ) : (
          incidents.map((incident: { id: string; title: string; source_url: string; incident_date: string }) => {
            let domain = "news source";
            try {
              domain = new URL(incident.source_url).hostname.replace("www.", "");
            } catch {}

            return (
              <a
                href={incident.source_url}
                target="_blank"
                rel="noopener noreferrer"
                class="citation-card"
              >
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
                  <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
                      <span style="font-size: 11px; font-weight: 800; text-transform: uppercase; background: rgba(220, 38, 38, 0.1); color: #dc2626; padding: 2px 8px; border-radius: 4px;">
                        {dbType}
                      </span>
                      <span class="badge-citation">
                        {domain}
                      </span>
                      <span style="color: var(--muted); font-size: 12px;">
                        Incident Date: {new Date(incident.incident_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </span>
                    </div>

                    <h3 style="margin: 0; color: var(--ink); font-size: 15px; font-weight: 700; line-height: 1.4;">
                      {incident.title}
                    </h3>
                  </div>

                  <div style="color: #dc2626; padding-top: 4px; flex-shrink: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                  </div>
                </div>
              </a>
            );
          })
        )}
      </div>
    </div>
  </section>
</BaseLayout>
