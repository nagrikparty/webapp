---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ManifestoVoting } from "@/components/ManifestoVoting";
---

<BaseLayout
  title="Nagrik Party | Manifesto"
  description="Public priorities built from verified local issues and supporter votes. Not a backroom deal."
>
  <section class="page-hero">
    <div class="container">
      <h1>Manifesto</h1>
      <p class="page-copy">
        The Nagrik Party manifesto has two layers: a national programme built from what the party stands for, and an area-wise manifesto built from verified local issues, public priorities, and member voting.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2 style="margin: 0 0 16px; font-size: 28px;">Top priorities</h2>
          <p style="color: var(--muted); line-height: 1.6;">
            Supporters and verified members can upvote proposals. The ranking is public. Voter identities are not shown.
          </p>
          <div class="notice" style="margin-top: 18px;">
            <strong>Pre-registration:</strong> Voting is open to supporters and members during the party formation phase. After registration, formal internal democracy processes will govern manifesto decisions.
          </div>
        </div>
        <ManifestoVoting client:load />
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="section-head">
        <h2>What the party stands for</h2>
      </div>
      <div class="grid-3">
        <div class="card feature">
          <h3>Visible governance</h3>
          <p>Every public action tracked, every escalation logged, every report published.</p>
        </div>
        <div class="card feature">
          <h3>Women safety</h3>
          <p>Streetlight audits, safety mapping, response cell with heightened privacy protections.</p>
        </div>
        <div class="card feature">
          <h3>Healthcare access</h3>
          <p>Public clinic tracking, medicine availability, community health infrastructure.</p>
        </div>
        <div class="card feature">
          <h3>Legal accessibility</h3>
          <p>Mohalla-level legal help desks, documentation assistance, citizen rights awareness.</p>
        </div>
        <div class="card feature">
          <h3>Youth and employment</h3>
          <p>Constituency libraries, skill hubs, community centres, and training programmes.</p>
        </div>
        <div class="card feature">
          <h3>Environment</h3>
          <p>Rainwater harvesting, flood-risk mapping, green civic infrastructure, sustainability campaigns.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
