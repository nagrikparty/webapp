---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
---

<BaseLayout
  title="Okhla - Nagrik Party"
  description="Okhla Assembly Constituency - the anchor constituency and first public proof point of Nagrik Party's civic work approach."
>
  <section class="page-hero">
    <div class="container">      <h1>
        <Bilingual en="Okhla" hi="ओखला" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Okhla Assembly Constituency is the Party President's 2025 independent contest constituency and serves as the first public proof point of the party's civic work approach. It is a starting point, not a limitation on the party's Delhi-wide launch scope."
          hi="ओखला विधानसभा क्षेत्र पार्टी अध्यक्ष की 2025 स्वतंत्र चुनाव विधानसभा है और पार्टी के नागरिक कार्य दृष्टिकोण का पहला सार्वजनिक प्रमाण बिंदु है। यह एक शुरुआती बिंदु है, पार्टी के दिल्ली-व्यापी लॉन्च दायरे पर सीमा नहीं।"
        />
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="legal-article">
          <h2>
            <Bilingual en="Why Okhla matters" hi="ओखला क्यों मायने रखती है" />
          </h2>
          <p>
            <Bilingual
              en="Okhla is where the Party President first engaged in electoral politics. The constituency represents the transition from independent candidacy to party formation. The local issues documented during the 2025 campaign - civic infrastructure, safety, sanitation, public services - form the basis of Nagrik Party's issue-first approach to politics."
              hi="ओखला वह जगह है जहां पार्टी अध्यक्ष ने सबसे पहले चुनावी राजनीति में भाग लिया। विधानसभा स्वतंत्र उम्मीदवारी से पार्टी गठन के परिवर्तन का प्रतिनिधित्व करती है। 2025 अभियान के दौरान दस्तावेज किए गए स्थानीय मुद्दे - नागरिक बुनियादी ढांचा, सुरक्षा, स्वच्छता, सार्वजनिक सेवाएं - नागरिक पार्टी के मुद्दा-प्रथम राजनीतिक दृष्टिकोण का आधार बनाते हैं।"
            />
          </p>

          <h2>
            <Bilingual en="Anchor constituency model" hi="एंकर विधानसभा मॉडल" />
          </h2>
          <p>
            <Bilingual
              en="Okhla is the first constituency where Nagrik Party will demonstrate its full civic operations model: issue intake from residents, volunteer-led verification, lawful complaint filing, public status tracking, and area-wise manifesto building. The model developed here will be replicated across Delhi's other 69 Assembly constituencies."
              hi="ओखला पहली विधानसभा है जहां नागरिक पार्टी अपना पूरा नागरिक संचालन मॉडल प्रदर्शित करेगी: निवासियों से मुद्दा प्रवेश, स्वयंसेवक-नेतृत्व सत्यापन, विधिसम्मत शिकायत दर्ज, सार्वजनिक स्थिति ट्रैकिंग, और क्षेत्रवार घोषणापत्र निर्माण। यहां विकसित मॉडल दिल्ली की अन्य 69 विधानसभाओं में दोहराया जाएगा।"
            />
          </p>

          <h2>
            <Bilingual en="Local issues pipeline" hi="स्थानीय मुद्दा पाइपलाइन" />
          </h2>
          <p>
            <Bilingual
              en="Citizens in Okhla can report civic issues through this platform. Reported issues go through verification, classification, and lawful escalation. Unresolved issues become part of the Okhla area manifesto - a living document that reflects what residents actually need."
              hi="ओखला के नागरिक इस प्लेटफॉर्म के माध्यम से नागरिक मुद्दे दर्ज कर सकते हैं। दर्ज मुद्दे सत्यापन, वर्गीकरण और विधिसम्मत एस्केलेशन से गुजरते हैं। अनसुलझे मुद्दे ओखला क्षेत्र घोषणापत्र का हिस्सा बनते हैं - एक जीवंत दस्तावेज जो दर्शाता है कि निवासियों को वास्तव में क्या चाहिए।"
            />
          </p>
        </div>
        <div>
          <div style="display: grid; gap: 14px;">
            <div class="card feature" style="padding: 18px;">
              <span class="mini-label"><Bilingual en="Location" hi="स्थान" /></span>
              <h3 style="font-size: 20px; margin-top: 8px;"><Bilingual en="South-East Delhi" hi="दक्षिण-पूर्व दिल्ली" /></h3>
            </div>
            <div class="card feature" style="padding: 18px;">
              <span class="mini-label"><Bilingual en="Status" hi="स्थिति" /></span>
              <h3 style="font-size: 20px; margin-top: 8px;"><Bilingual en="Anchor constituency" hi="एंकर विधानसभा" /></h3>
              <p style="font-size: 14px;"><Bilingual en="First constituency for full civic operations model." hi="पूर्ण नागरिक संचालन मॉडल के लिए पहली विधानसभा।" /></p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <span class="mini-label"><Bilingual en="What you can do" hi="आप क्या कर सकते हैं" /></span>
              <div style="display: grid; gap: 10px; margin-top: 10px;">
                <a class="button green" href="/issues" style="justify-content: start;">
                  <Bilingual en="Report an Okhla issue" hi="ओखला का मुद्दा दर्ज करें" />
                </a>
                <a class="button" href="/volunteer" style="justify-content: start;">
                  <Bilingual en="Volunteer in Okhla" hi="ओखला में स्वयंसेवक बनें" />
                </a>
                <a class="button" href="/membership" style="justify-content: start;">
                  <Bilingual en="Apply for membership" hi="सदस्यता के लिए आवेदन करें" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="action-row" style="justify-content: center;">
        <a class="button" href="/president">
          <Bilingual en="← Back to President" hi="← अध्यक्ष पर वापस" />
        </a>
        <a class="button" href="/president/delhi-2025">
          <Bilingual en="← Delhi 2025" hi="← दिल्ली 2025" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
