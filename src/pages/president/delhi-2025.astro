---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
---

<BaseLayout
  title="Delhi 2025 - Nagrik Party"
  description="Arsalan Azad's independent candidacy in the Delhi 2025 Assembly election from Okhla - the starting point of Nagrik Party."
>
  <section class="page-hero">
    <div class="container">      <h1>
        <Bilingual en="Delhi 2025" hi="दिल्ली 2025" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="Arsalan Azad contested the Delhi 2025 MLA election independently from Okhla Assembly Constituency, South-East Delhi. This election was the starting point of the transition from independent public work to building Nagrik Party."
          hi="अरसलान आज़ाद ने दिल्ली 2025 विधानसभा चुनाव में ओखला विधानसभा क्षेत्र, दक्षिण-पूर्व दिल्ली से स्वतंत्र रूप से चुनाव लड़ा। यह चुनाव स्वतंत्र सार्वजनिक कार्य से नागरिक पार्टी के निर्माण में परिवर्तन का शुरुआती बिंदु था।"
        />
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="legal-article">
          <h2>
            <Bilingual en="Election context" hi="चुनाव संदर्भ" />
          </h2>
          <p>
            <Bilingual
              en="The Delhi 2025 Assembly election saw Arsalan Azad stand as an Independent candidate from Okhla. Public election records list the result as 270 votes received. The campaign was described in media coverage as issue-focused and built around direct and digital outreach."
              hi="दिल्ली 2025 विधानसभा चुनाव में अरसलान आज़ाद ने ओखला से स्वतंत्र उम्मीदवार के रूप में खड़े हुए। सार्वजनिक चुनाव रिकॉर्ड में 270 वोट प्राप्त होने का परिणाम सूचीबद्ध है। मीडिया कवरेज में अभियान को मुद्दा-केंद्रित और प्रत्यक्ष तथा डिजिटल आउटरीच पर बनाया गया बताया गया।"
            />
          </p>

          <h2>
            <Bilingual en="Campaign approach" hi="अभियान दृष्टिकोण" />
          </h2>
          <p>
            <Bilingual
              en="The campaign prioritised local civic issues over identity-based mobilisation. Outreach was built through direct engagement with residents and digital communication channels. The focus was on documenting public problems and proposing transparent governance solutions."
              hi="अभियान ने पहचान-आधारित लामबंदी पर स्थानीय नागरिक मुद्दों को प्राथमिकता दी। आउटरीच निवासियों के साथ प्रत्यक्ष जुड़ाव और डिजिटल संचार चैनलों के माध्यम से बनाया गया। ध्यान सार्वजनिक समस्याओं के दस्तावेज और पारदर्शी शासन समाधान प्रस्तावित करने पर था।"
            />
          </p>

          <h2>
            <Bilingual en="From election to party" hi="चुनाव से पार्टी तक" />
          </h2>
          <p>
            <Bilingual
              en="The independent candidacy demonstrated that issue-based politics needs institutional infrastructure to scale. Nagrik Party is being built as that institutional step - a member-driven party where public work is tracked, civic issues are filed lawfully, and every action produces a visible record."
              hi="स्वतंत्र उम्मीदवारी ने प्रदर्शित किया कि मुद्दा-आधारित राजनीति को पैमाने पर ले जाने के लिए संस्थागत बुनियादी ढांचे की जरूरत है। नागरिक पार्टी उस संस्थागत कदम के रूप में बनाई जा रही है - एक सदस्य-संचालित पार्टी जहां सार्वजनिक कार्य ट्रैक होता है, नागरिक मुद्दे विधिसम्मत रूप से दर्ज होते हैं, और हर कार्य एक दिखने वाला रिकॉर्ड बनाता है।"
            />
          </p>

          <div class="notice" style="margin-top: 24px;">
            <strong>
              <Bilingual en="Public record source:" hi="सार्वजनिक रिकॉर्ड स्रोत:" />
            </strong>{" "}
            <Bilingual
              en="Election results and candidate details are from public ADR/MyNeta archives and Election Commission records."
              hi="चुनाव परिणाम और उम्मीदवार विवरण सार्वजनिक ADR/MyNeta अभिलेखागार और निर्वाचन आयोग रिकॉर्ड से हैं।"
            />
          </div>
        </div>
        <div>
          <div style="display: grid; gap: 14px;">
            <div class="card feature" style="padding: 18px;">
              <span class="mini-label"><Bilingual en="Constituency" hi="विधानसभा" /></span>
              <h3 style="font-size: 20px; margin-top: 8px;"><Bilingual en="Okhla" hi="ओखला" /></h3>
              <p style="font-size: 14px;"><Bilingual en="South-East Delhi" hi="दक्षिण-पूर्व दिल्ली" /></p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <span class="mini-label"><Bilingual en="Category" hi="श्रेणी" /></span>
              <h3 style="font-size: 20px; margin-top: 8px;"><Bilingual en="Independent" hi="स्वतंत्र" /></h3>
              <p style="font-size: 14px;"><Bilingual en="No party affiliation at the time of election" hi="चुनाव के समय कोई पार्टी संबद्धता नहीं" /></p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <span class="mini-label"><Bilingual en="Campaign style" hi="अभियान शैली" /></span>
              <h3 style="font-size: 20px; margin-top: 8px;"><Bilingual en="Issue-focused" hi="मुद्दा-केंद्रित" /></h3>
              <p style="font-size: 14px;"><Bilingual en="Direct and digital outreach on civic issues" hi="नागरिक मुद्दों पर प्रत्यक्ष और डिजिटल आउटरीच" /></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="action-row" style="justify-content: center;">
        <a class="button" href="/president">
          <Bilingual en="← Back to President" hi="← अध्यक्ष पर वापस" />
        </a>
        <a class="button" href="/president/okhla">
          <Bilingual en="Okhla constituency →" hi="ओखला विधानसभा →" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
