---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Bilingual from "@/components/Bilingual.astro";
---

<BaseLayout
  title="About the President - Nagrik Party"
  description="Arsalan Azad - background, vision and the transition from independent candidacy to party formation."
>
  <section class="page-hero">
    <div class="container">      <h1>
        <Bilingual en="About Arsalan Azad" hi="अरसलान आज़ाद के बारे में" />
      </h1>
      <p class="page-copy">
        <Bilingual
          en="The political narrative leads with public work, Delhi, constitutional politics, civic issues, independent candidacy and party formation."
          hi="राजनीतिक कथा सार्वजनिक कार्य, दिल्ली, संवैधानिक राजनीति, नागरिक मुद्दे, स्वतंत्र उम्मीदवारी और पार्टी गठन से शुरू होती है।"
        />
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container legal-article">
      <h2>
        <Bilingual en="Public identity" hi="सार्वजनिक पहचान" />
      </h2>
      <p>
        <Bilingual
          en="Arsalan Azad is the founding Party President of Nagrik Party. He contested the Delhi 2025 MLA election independently from Okhla Assembly Constituency, South-East Delhi. His profession is listed as Social Worker in his public candidate affidavit with no criminal cases declared."
          hi="अरसलान आज़ाद नागरिक पार्टी के संस्थापक पार्टी अध्यक्ष हैं। उन्होंने दिल्ली 2025 विधानसभा चुनाव में ओखला विधानसभा क्षेत्र, दक्षिण-पूर्व दिल्ली से स्वतंत्र रूप से चुनाव लड़ा। उनके सार्वजनिक उम्मीदवार शपथपत्र में उनका पेशा समाज सेवक सूचीबद्ध है और कोई आपराधिक मामला घोषित नहीं है।"
        />
      </p>

      <h2>
        <Bilingual en="Political background" hi="राजनीतिक पृष्ठभूमि" />
      </h2>
      <p>
        <Bilingual
          en="Arsalan Azad's entry into electoral politics came through the Delhi 2025 Assembly election, where he stood as an Independent candidate from Okhla. The campaign was issue-focused and built around direct and digital outreach rather than identity-based mobilisation."
          hi="अरसलान आज़ाद का चुनावी राजनीति में प्रवेश दिल्ली 2025 विधानसभा चुनाव से हुआ, जहां उन्होंने ओखला से स्वतंत्र उम्मीदवार के रूप में खड़े हुए। अभियान मुद्दा-केंद्रित था और पहचान-आधारित लामबंदी के बजाय प्रत्यक्ष और डिजिटल आउटरीच पर बनाया गया था।"
        />
      </p>

      <h2>
        <Bilingual en="Vision for Nagrik Party" hi="नागरिक पार्टी के लिए दृष्टि" />
      </h2>
      <p>
        <Bilingual
          en="Nagrik Party is the next institutional step - converting independent public work into a transparent, member-driven political organisation. The party is designed as a constitutional home for independent candidates, civic leaders, local organisers, professionals and public-service volunteers who want disciplined party infrastructure without opaque high-command politics."
          hi="नागरिक पार्टी अगला संस्थागत कदम है - स्वतंत्र सार्वजनिक कार्य को एक पारदर्शी, सदस्य-संचालित राजनीतिक संगठन में बदलना। पार्टी स्वतंत्र उम्मीदवारों, नागरिक नेताओं, स्थानीय संगठकों, पेशेवरों और सार्वजनिक सेवा स्वयंसेवकों के लिए एक संवैधानिक घर के रूप में डिज़ाइन की गई है जो अपारदर्शी हाई-कमांड राजनीति के बिना अनुशासित पार्टी बुनियादी ढांचा चाहते हैं।"
        />
      </p>

      <h2>
        <Bilingual en="Approach to politics" hi="राजनीति के प्रति दृष्टिकोण" />
      </h2>
      <p>
        <Bilingual
          en="The party collects public problems from citizens, verifies them through volunteers, files lawful complaints before elections, and converts unresolved issues into area-wise manifesto commitments. After electoral victory, the same records become the delivery checklist. This is what 'Kaam dikhna chahiye' means in practice."
          hi="पार्टी नागरिकों से सार्वजनिक समस्याएं जमा करती है, स्वयंसेवकों के माध्यम से सत्यापित करती है, चुनाव से पहले विधिसम्मत शिकायतें दर्ज करती है, और अनसुलझे मुद्दों को क्षेत्रवार घोषणापत्र प्रतिबद्धताओं में बदलती है। चुनावी जीत के बाद, वही रिकॉर्ड डिलीवरी चेकलिस्ट बन जाते हैं। व्यवहार में 'काम दिखना चाहिए' का यही मतलब है।"
        />
      </p>

      <div class="action-row" style="margin-top: 28px;">
        <a class="button" href="/president">
          <Bilingual en="← Back to President" hi="← अध्यक्ष पर वापस" />
        </a>
        <a class="button" href="/president/delhi-2025">
          <Bilingual en="Delhi 2025 →" hi="दिल्ली 2025 →" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
