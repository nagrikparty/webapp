---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitemapStructure } from "@/lib/navigation";
import { ArrowRight, Compass } from "lucide-react";
---

<BaseLayout
  title="Sitemap | Nagrik Party"
  description="Complete public directory of Nagrik Party pages, charters, transparency ledgers, and civic resources."
>
  <section class="page-hero">
    <div class="container" style="max-width: 960px;">
      <div class="mini-label" style="background: rgba(179, 74, 21, 0.08); color: var(--saffron);">
        Public Directory
      </div>
      <h1 style="font-size: clamp(2rem, 4vw, 2.8rem); margin: 8px 0 12px; font-family: var(--font-serif);">
        Platform Sitemap
      </h1>
      <p style="max-width: 640px; color: var(--muted); font-size: 15.5px; margin: 0;">
        A complete, structured directory of Nagrik Party's public foundation pages, legal charters, transparency ledgers, and civic tools.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 36px; padding-bottom: 64px;">
    <div class="container" style="max-width: 960px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        {sitemapStructure.map((section) => (
          <div
            class="card"
            style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: 22px; box-shadow: var(--shadow);"
          >
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--line); padding-bottom: 10px;">
              <Compass size={16} style={{ color: "var(--saffron)" }} />
              <h2 style="font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-mono); margin: 0; color: var(--ink);">
                {section.title}
              </h2>
            </div>

            <ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 12px;">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    style="display: flex; flex-direction: column; text-decoration: none; color: inherit; group: hover;"
                  >
                    <span style="font-size: 14px; font-weight: 600; color: var(--ink); display: flex; align-items: center; gap: 6px;">
                      {item.label}
                      <ArrowRight size={13} style={{ color: "var(--saffron)", opacity: 0.8 }} />
                    </span>
                    {item.description && (
                      <span style="font-size: 12px; color: var(--muted); margin-top: 2px; line-height: 1.4;">
                        {item.description}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
