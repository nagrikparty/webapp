---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FOUNDER_DATA } from "@/lib/founder";
import { ShieldCheck, MapPin, Scale } from "lucide-react";
---

<BaseLayout
  title="Founder Profile | Sheikh Arsalanullah Chishti | Nagrik Party"
  description="Biographical background and accountability record of Sheikh Arsalanullah Chishti (Arsalan Azad), Founding Convener of Nagrik Party in its Formation Phase."
>
  <section class="page-hero">
    <div class="container" style="max-width: 960px;">
      <div class="mini-label" style="background: rgba(179, 74, 21, 0.08); color: var(--saffron);">
        Leadership & Accountability
      </div>
      <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); margin: 8px 0 12px; font-family: var(--font-serif);">
        Sheikh Arsalanullah Chishti
      </h1>
      <p style="font-size: 16px; color: var(--muted); margin: 0;">
        Founder / Founding Convener (Formation Phase) · Known in public work as <strong>{FOUNDER_DATA.publicName}</strong>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 36px; padding-bottom: 56px;">
    <div class="container" style="max-width: 960px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; align-items: start;">
        
        <!-- Founder Portrait & Metadata Card -->
        <div class="card" style="background: var(--paper-card); border: 1px solid var(--line-strong); border-radius: 4px; padding: 24px; box-shadow: var(--shadow);">
          <div style="width: 100%; aspect-ratio: 1; border-radius: 3px; overflow: hidden; background: var(--paper-subtle); border: 1px solid var(--line); margin-bottom: 20px; display: flex; align-items: center; justify-content: center;">
            <img
              src={FOUNDER_DATA.imageSlot}
              alt="Sheikh Arsalanullah Chishti (Arsalan Azad)"
              style="width: 100%; height: 100%; object-fit: cover; object-position: center 15%;"
              onerror="this.onerror=null; this.src='/nagrikpartylogo.svg'; this.style.padding='40px';"
            />
          </div>

          <h2 style="font-size: 18px; font-weight: 700; font-family: var(--font-serif); margin: 0 0 4px; color: var(--ink);">
            {FOUNDER_DATA.legalName}
          </h2>
          <div style="font-size: 13px; color: var(--saffron); font-weight: 600; margin-bottom: 16px;">
            {FOUNDER_DATA.role}
          </div>

          <div style="display: grid; gap: 10px; font-size: 13px; color: var(--ink-body); border-top: 1px solid var(--line); padding-top: 14px;">
            <div style="display: flex; gap: 8px;">
              <MapPin size={15} style={{ color: "var(--muted)", flexShrink: 0, marginTop: 2 }} />
              <span>Okhla, New Delhi, India</span>
            </div>
            <div style="display: flex; gap: 8px;">
              <Scale size={15} style={{ color: "var(--muted)", flexShrink: 0, marginTop: 2 }} />
              <span>2025 Delhi Assembly Independent Candidate</span>
            </div>
            <div style="display: flex; gap: 8px;">
              <ShieldCheck size={15} style={{ color: "var(--green)", flexShrink: 0, marginTop: 2 }} />
              <span>Section 29A RPA 1951 Formation Proponent</span>
            </div>
          </div>
        </div>

        <!-- Biography & Record -->
        <div>
          <div class="card" style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: 28px; box-shadow: var(--shadow); margin-bottom: 24px;">
            <h3 style="font-size: 18px; font-weight: 700; font-family: var(--font-serif); margin: 0 0 14px; color: var(--ink);">
              Public Service Background
            </h3>
            <p style="font-size: 14.5px; line-height: 1.65; color: var(--ink-body); margin: 0 0 14px;">
              Sheikh Arsalanullah Chishti contested the 2025 Delhi Legislative Assembly election as an independent candidate in the Okhla constituency. The experience on the ground, engaging with civic grievances, local municipal apathy, and electoral machinery, established the imperative to create a durable, democratic organisation rather than sustaining isolated independent campaigns.
            </p>
            <p style="font-size: 14.5px; line-height: 1.65; color: var(--ink-body); margin: 0 0 14px;">
              Coming from a family with decades of public service in teaching and education, he observed firsthand that years of honest public work and societal contribution do not automatically guarantee protection against inflation, healthcare costs, and institutional vulnerability in later life.
            </p>
            <p style="font-size: 14.5px; line-height: 1.65; color: var(--ink-body); margin: 0;">
              This lived experience forms the central thesis of Nagrik Party: building a permanent, citizen-driven institution where ordinary voters transition from spectators into active decision-makers.
            </p>
          </div>

          <!-- Constitutional Status Note -->
          <div class="card" style="background: var(--paper-subtle); border: 1px solid var(--line-strong); border-left: 3px solid var(--saffron); border-radius: 4px; padding: 18px 22px;">
            <div style="font-size: 12px; font-weight: 700; font-family: var(--font-mono); color: var(--saffron); text-transform: uppercase; margin-bottom: 4px;">
              Statutory Status Disclosure
            </div>
            <p style="font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0;">
              Sheikh Arsalanullah Chishti serves as the Founding Convener of Nagrik Party during its Formation Phase. In strict compliance with Section 29A RPA 1951 guidelines, formal ratified executive offices will be confirmed at the General Body Convention of verified founding members.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
