---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { VolunteerForm } from "@/components/SignupForms";
---

<BaseLayout
  title="Nagrik Party | Volunteer"
  description="Help verify civic issues, translate content, do local research, and manage outreach. No party membership needed."
>
  <section class="page-hero">
    <div class="container">
      <h1>Volunteer</h1>
      <p class="page-copy">
        Volunteers help with issue verification, outreach, translation, local research, event support, and digital tasks. Volunteering is not legal party membership: you can help without enrolling as a member.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <h2 style="margin: 0 0 16px; font-size: 28px;">How volunteers help</h2>
          <div class="grid-2" style="gap: 14px;">
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 16px;">Issue verification</h3>
              <p style="font-size: 14px;">Ground-check reported problems in your ward or area.</p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 16px;">Translation</h3>
              <p style="font-size: 14px;">Help make content accessible in Hindi and English.</p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 16px;">Local research</h3>
              <p style="font-size: 14px;">Document ward-level issues, infrastructure gaps, and public needs.</p>
            </div>
            <div class="card feature" style="padding: 18px;">
              <h3 style="font-size: 16px;">Digital outreach</h3>
              <p style="font-size: 14px;">Social media, data entry, content moderation, and design.</p>
            </div>
          </div>
          <div class="notice" style="margin-top: 18px;">
            <strong>Important:</strong> This is a volunteer and supporter application. It is not legal party membership. To become a legal party member, use the membership application page.
          </div>
        </div>
        <VolunteerForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>
