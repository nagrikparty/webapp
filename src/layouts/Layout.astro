---
import '@/styles/globals.css';
import Navbar from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer';
import { ThemeProvider } from '@/components/ThemeProvider';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Nagrik Party", 
  description = "A constitutional governance platform" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F7F5" />
    <title>{title}</title>
    
    <!-- Google Fonts equivalent to next/font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700&family=Mukta:wght@300;400;500;600;700;800&family=Teko:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --font-inter: 'Inter Tight', sans-serif;
        --font-mukta: 'Mukta', sans-serif;
        --font-teko: 'Teko', sans-serif;
      }
    </style>
  </head>
  <body class="bg-off-white text-black font-body antialiased selection:bg-red selection:text-white min-h-screen flex flex-col transition-colors duration-300">
    <ThemeProvider attribute="class" defaultTheme="system" enableSystem client:load>
      <div id="main-content">
        <Navbar client:load />
        <slot />
        <Footer client:load />
      </div>
    </ThemeProvider>
  </body>
</html>
