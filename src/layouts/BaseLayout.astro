---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Bilingual from "@/components/Bilingual.astro";
import Logo from "@/components/Logo.astro";
import { SmartIsland } from "@/components/SmartIsland";
import { legalLinks } from "@/lib/content";

const {
  title = "Nagrik Party",
  description = "Delhi-first proposed political party under registration.",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Yantramanav:wght@700;900&display=swap" rel="stylesheet">
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      try {
        const stored = localStorage.getItem("preferred_lang");
        if (stored) {
          document.documentElement.setAttribute("data-lang", stored);
          document.documentElement.lang = stored;
        }
      } catch {}
    </script>
  </head>
  <body class={bodyClass}>
    <div class="site-shell">
      <div class="nav-wrapper">
        <header class="nav">
          <div class="nav-inner">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">
              <Logo width={18} height={18} />
            </span>
            <span class="brand-word">
              <Bilingual en="Nagrik Party" hi="नागरिक पार्टी" />
            </span>
          </a>
            <SmartIsland client:load />
          </div>
        </header>
      </div>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <div class="container footer-grid">
          <div>
            <a class="brand" href="/">
              <span class="brand-mark footer-brand-mark" aria-hidden="true">
                <Logo width={18} height={18} />
              </span>
              <span class="brand-word">
                <span><Bilingual en="Nagrik Party" hi="नागरिक पार्टी" /></span>
                <small><Bilingual en="Under Registration" hi="पंजीकरण के अधीन" /></small>
              </span>
            </a>
            <p>
              <Bilingual
                en="A Delhi-first proposed political party building a public worklist before power."
                hi="दिल्ली-प्रथम प्रस्तावित राजनीतिक पार्टी, सत्ता से पहले सार्वजनिक काम की सूची बना रही है।"
              />
            </p>
            <small>© 2026 Nagrik Party. Under registration.</small>
          </div>
          <div class="footer-links">
            <div>
              <strong>Platform</strong>
              <a href="/manifesto">Manifesto Top 10</a>
              <a href="/issues">Report an issue</a>
              <a href="/volunteer">Volunteer</a>
              <a href="/membership">Membership</a>
            </div>
            <div>
              <strong>Leadership</strong>
              <a href="/president">Party President</a>
              <a href="/president/delhi-2025">Delhi 2025</a>
              <a href="/president/okhla">Okhla</a>
              <a href="/about">About Nagrik Party</a>
            </div>
            <div>
              <strong>Legal</strong>
              {legalLinks.map((link) => <a href={`/legal/${link.slug}`}>{link.en}</a>)}
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
