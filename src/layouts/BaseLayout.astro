---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Logo from "@/components/Logo.astro";
import { SmartIsland } from "@/components/SmartIsland";
import { FoundingProgressBar } from "@/components/FoundingProgressBar";
import { footerSections } from "@/lib/navigation";

const {
  title = "Nagrik Party | Formation Phase",
  description = "An independent political initiative working toward the formation and registration of a political party under Section 29A RPA 1951.",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="icon" type="image/svg+xml" href="/nagrikpartylogo.svg" />
    <link rel="apple-touch-icon" href="/nagrikpartylogo.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Nagrik Party" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/nagrikpartylogo.svg", Astro.url).href} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/nagrikpartylogo.svg", Astro.url).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Noto+Serif+Devanagari:wght@400;600;700&family=Yantramanav:wght@500;700;900&display=swap" rel="stylesheet">
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <div class="site-shell">
      <div class="nav-wrapper">
        <header class="nav">
          <div class="nav-inner">
            <a class="brand" href="/" aria-label="Nagrik Party Home">
              <Logo height={38} className="brand-logo" />
              <div class="brand-word">
                <span class="brand-word-title">Nagrik Party</span>
                <small>Formation Phase</small>
              </div>
            </a>
            <SmartIsland client:load />
          </div>
        </header>
        <FoundingProgressBar client:load />
      </div>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <div class="container footer-grid">
          <div>
            <a class="brand footer-brand" href="/" aria-label="Nagrik Party Home">
              <Logo height={42} className="brand-logo footer-logo" />
              <div class="brand-word">
                <span class="brand-word-title">Nagrik Party</span>
                <small>PHASE 1 · FORMATION PHASE</small>
              </div>
            </a>
            <p style="margin: 14px 0; color: var(--muted); font-size: 13.5px; line-height: 1.55; max-width: 400px;">
              Nagrik Party (Formation Phase): An independent political initiative working toward the formation and registration of a political party under Section 29A RPA 1951. Kaam dikhna chahiye.
            </p>
            <small style="display: block; color: var(--ink-faint); font-size: 11.5px; line-height: 1.5;">
              © 2026 Nagrik Party. Formation Phase (Proposed for registration under Section 29A RPA 1951). Membership cards and Nagrik IDs are organisational records, not government-issued documents.
            </small>
          </div>
          <div class="footer-links">
            {footerSections.map((section) => (
              <div>
                <strong>{section.title}</strong>
                {section.items.map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </div>
            ))}
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
