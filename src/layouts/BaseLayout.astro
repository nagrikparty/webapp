---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Bilingual from "@/components/Bilingual.astro";
import Logo from "@/components/Logo.astro";
import { SmartIsland } from "@/components/SmartIsland";
import { legalLinks } from "@/lib/content";

const {
  title = "Nagrik Party",
  description = "Delhi-first proposed political party under registration.",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="icon" type="image/svg+xml" href="/nagrikpartylogo.svg" />
    <link rel="apple-touch-icon" href="/nagrikpartylogo.svg" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Nagrik Party | नागरिक पार्टी" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/nagrikpartylogo.svg", Astro.url).href} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/nagrikpartylogo.svg", Astro.url).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Noto+Serif+Devanagari:wght@400;600;700&family=Yantramanav:wght@500;700;900&display=swap" rel="stylesheet">
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      try {
        const stored = localStorage.getItem("preferred_lang");
        if (stored) {
          document.documentElement.setAttribute("data-lang", stored);
          document.documentElement.lang = stored;
        }
      } catch {}
    </script>
  </head>
  <body class={bodyClass}>
    <div class="site-shell">
      <div class="nav-wrapper">
        <header class="nav">
          <div class="nav-inner">
          <a class="brand" href="/" aria-label="Nagrik Party Home">
            <Logo height={38} className="brand-logo" />
            <div class="brand-word">
              <span class="brand-word-title"><Bilingual en="Nagrik Party" hi="नागरिक पार्टी" /></span>
              <small><Bilingual en="Formation Phase" hi="गठन चरण" /></small>
            </div>
          </a>
            <SmartIsland client:load />
          </div>
        </header>
      </div>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <div class="container footer-grid">
          <div>
            <a class="brand footer-brand" href="/" aria-label="Nagrik Party Home">
              <Logo height={42} className="brand-logo footer-logo" />
              <div class="brand-word">
                <span class="brand-word-title"><Bilingual en="Nagrik Party" hi="नागरिक पार्टी" /></span>
                <small><Bilingual en="Under Registration" hi="पंजीकरण के अधीन" /></small>
              </div>
            </a>
            <p>
              <Bilingual
                en="Nagrik Party — Formation Phase: An independent political initiative working toward the formation and registration of a political party."
                hi="नागरिक पार्टी — गठन चरण: एक राजनीतिक पार्टी के गठन और पंजीकरण की दिशा में काम करने वाली एक स्वतंत्र राजनीतिक पहल।"
              />
            </p>
            <small>© 2026 Nagrik Party. Formation Phase (Proposed for registration under Section 29A RPA 1951).</small>
          </div>
          <div class="footer-links">
            <div>
              <strong><Bilingual en="Platform" hi="मंच" /></strong>
              <a href="/crime"><Bilingual en="Verified Crime Tracker" hi="सत्यापित अपराध ट्रैकर" /></a>
              <a href="/manifesto"><Bilingual en="Manifesto Priorities" hi="घोषणापत्र प्राथमिकताएं" /></a>
              <a href="/issues"><Bilingual en="Report Civic Issue" hi="नागरिक मुद्दा दर्ज करें" /></a>
              <a href="/volunteer"><Bilingual en="Volunteer" hi="स्वयंसेवक बनें" /></a>
              <a href="/membership"><Bilingual en="Membership Induction" hi="सदस्यता प्रेरण" /></a>
            </div>
            <div>
              <strong><Bilingual en="Formation & Governance" hi="गठन और शासन" /></strong>
              <a href="/formation-progress"><Bilingual en="9-Stage Roadmap" hi="9-चरणीय रोडमैप" /></a>
              <a href="/transparency"><Bilingual en="Financial Transparency" hi="वित्तीय पारदर्शिता" /></a>
              <a href="/documents"><Bilingual en="Public Document Vault" hi="सार्वजनिक दस्तावेज़ वॉल्ट" /></a>
              <a href="/member"><Bilingual en="Member Portal" hi="सदस्य पोर्टल" /></a>
              <a href="/admin"><Bilingual en="Admin Console" hi="प्रशासन कंसोल" /></a>
            </div>
            <div>
              <strong><Bilingual en="Leadership" hi="नेतृत्व" /></strong>
              <a href="/president"><Bilingual en="Party President" hi="पार्टी अध्यक्ष" /></a>
              <a href="/president/delhi-2025"><Bilingual en="Delhi 2025 Campaign" hi="दिल्ली 2025 अभियान" /></a>
              <a href="/president/okhla"><Bilingual en="Okhla Anchor" hi="ओखला एंकर" /></a>
              <a href="/about"><Bilingual en="About Nagrik Party" hi="नागरिक पार्टी परिचय" /></a>
            </div>
            <div>
              <strong><Bilingual en="Legal Charters" hi="कानूनी घोषणापत्र" /></strong>
              {legalLinks.map((link) => (
                <a href={`/legal/${link.slug}`}>
                  <Bilingual en={link.en} hi={link.hi} />
                </a>
              ))}
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
