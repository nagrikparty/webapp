PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_RAZORPAY_KEY=
PUBLIC_ADMIN_EMAIL=

# Daily crime RSS sync (Cloudflare secret + GitHub Actions secrets me same value rakho)
# Local: .env me, Production: npx wrangler secret put CRON_SECRET
CRON_SECRET=
# Public site URL (GitHub Actions workflow me SITE_URL secret ke roop me)
# SITE_URL=https://nagrik.party

# Sentry error monitoring (see sentry.client.config.js / sentry.server.config.js)
# DSN is public-safe and already embedded in the config files; override if needed.
PUBLIC_SENTRY_DSN=
# Auth token ONLY for source-map upload during build (never expose to client).
# Generate at: https://nagrik-party.sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=
# Brevo transactional email (nagrik.party domain). API key stays server-side only —
# on Cloudflare production set via: npx wrangler secret put BREVO_API_KEY
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@nagrik.party
BREVO_FROM_NAME=Nagrik Party
