{
  "name": "nagrik-party-webapp",
  "compatibility_date": "2024-04-05",
  "pages_build_output_dir": ".open-next/worker",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagrik_db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "nagrik-reports"
    }
  ]
}
