{
  "name": "webapp",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/_worker.js/index.js",

  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagrik",
      "database_id": "216c780f-c6c8-421d-b7c3-f8ba7ba2da72"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "nagrik"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    // Add secrets using `wrangler secret put <VAR_NAME>` or via the Cloudflare dashboard
    "DIDIT_API_KEY": "",
    "DIDIT_WORKFLOW_ID": "",
    "NEXT_PUBLIC_SUPABASE_URL": "",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": ""
  }
}
