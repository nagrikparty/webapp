{
  "name": "nagrik-party-webapp",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagrik",
      "database_id": "216c780f-c6c8-421d-b7c3-f8ba7ba2da72"
    }
  ]
}
