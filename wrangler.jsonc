{
  "name": "webapp",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagrik",
      "database_id": "216c780f-c6c8-421d-b7c3-f8ba7ba2da72"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "nagrik"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "DIDIT_API_KEY": "aWfsaiK7n52qyEKhXeLgz0Lw4ijzgA9jxVcsKBUdIzU",
    "DIDIT_WORKFLOW_ID": "20eed894-B0f4-4ffa-9891-e363da88dfd9",
