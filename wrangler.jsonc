{
  // Base Cloudflare Worker config. @astrojs/cloudflare merges this into
  // dist/server/wrangler.json at build time.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-04-15",
  // Required by @sentry/cloudflare (worker bundle statically imports node:async_hooks)
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // Email sending identity: official logo used in templates. Plain-text
  // var is the source of truth for discovery consumers too.
  "vars": {
    "BREVO_FROM_EMAIL": "hello@nagrik.party",
    "BREVO_FROM_NAME": "Nagrik Party",
    "EMAIL_LOGO_URL": "https://nagrik.party/brand/logo.png",
    // Server-side Sentry DSN (public-safe — same value is already embedded in
    // sentry.client.config.js for browser reporting).
    // SENTRY_AUTH_TOKEN is NEVER in this file — it is a Worker secret
    // (npx wrangler secret put SENTRY_AUTH_TOKEN).
    "SENTRY_DSN": "https://90dc2f322f7eb9661b6d1612bbb8a0d2@o4512114701303808.ingest.de.sentry.io/4512114707202128"
  }
}
