{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/education/layout,_N_T_/education/page,_N_T_/education"},"segmentPaths":["/_tree","/_full","/education/__PAGE__","/education","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"__variable_cf896d __variable_5dd352 __variable_91e1e6\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/88074b3575cc8ac4.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/e3f1d182f089bf20.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-5b1711e075e5183b.js\"/><script src=\"/_next/static/chunks/4bd1b696-e356ca5ba0218e27.js\" async=\"\"></script><script src=\"/_next/static/chunks/3794-ba2500baa4c52d55.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-382294912532d7a9.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-1b93a5baf91874e7.js\" async=\"\"></script><script src=\"/_next/static/chunks/8500-f62a38ff68ab7f42.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/education/page-08f0e74ec9d60d53.js\" async=\"\"></script><title>Nagrik Party</title><meta name=\"description\" content=\"A constitutional governance platform\"/><link rel=\"icon\" href=\"/favicon.ico?603d046c9a6fdfbb\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-off-white text-black font-body antialiased min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c=\"class\"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&\"system\"===a?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":a;k(d)}catch(a){}})(\"class\",\"theme\",\"system\",null,[\"light\",\"dark\"],null,true,true)</script><div class=\"min-h-screen bg-[#F5F1E8] text-[#0A0A0A] font-sans selection:bg-[#A11212] selection:text-[#F5F1E8]\"><nav class=\"border-b border-black/10 bg-white/80 backdrop-blur-md sticky top-0 z-50\"><div class=\"max-w-7xl mx-auto px-6 h-14 flex items-center justify-between\"><a class=\"flex items-center gap-2 hover:opacity-70 transition-opacity\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg><span class=\"font-bold tracking-tight text-sm uppercase\">Return to Ecosystem</span></a><div class=\"font-mono text-xs uppercase font-bold text-black/40\">SYSTEM: CIVIC_EDUCATION</div></div></nav><main class=\"max-w-7xl mx-auto px-6 py-12 space-y-16\"><header class=\"max-w-4xl border-b-4 border-[#0A0A0A] pb-8\"><div class=\"inline-block bg-[#0A0A0A] text-white px-3 py-1 text-xs font-mono font-bold uppercase mb-4\">Digital Democracy Tools</div><h1 class=\"text-5xl md:text-7xl font-bold tracking-tighter leading-[0.9] mb-6\">Constitutional <br class=\"hidden md:block\"/> Education Hub.</h1><p class=\"text-xl text-black/70 font-medium leading-relaxed max-w-2xl\">A decentralized movement requires an educated citizenry. Master your civic rights, learn how to audit your local municipality, and weaponize the constitution against corruption.</p></header><section><div class=\"flex justify-between items-end mb-8 border-b border-black/10 pb-4\"><h2 class=\"text-3xl font-bold\">Know Your Rights</h2><div class=\"font-mono text-xs text-black/40 uppercase\">Module 01</div></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\"><div class=\"bg-white border border-black/10 hover:border-[#0A0A0A] transition-all p-6 relative overflow-hidden group cursor-pointer flex flex-col h-64\"><div class=\"flex justify-between items-start mb-4\"><div class=\"bg-black/5 p-2 text-[#0A0A0A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-scroll-text\" aria-hidden=\"true\"><path d=\"M15 12h-5\"></path><path d=\"M15 8h-5\"></path><path d=\"M19 17V5a2 2 0 0 0-2-2H4\"></path><path d=\"M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3\"></path></svg></div><div class=\"text-[10px] font-mono uppercase font-bold tracking-widest text-black/40\">Transparency</div></div><h3 class=\"text-xl font-bold leading-tight mb-2 group-hover:text-[#A11212] transition-colors\">How to File a Bulletproof RTI</h3><p class=\"text-sm text-black/60 font-medium line-clamp-3\">The Right to Information Act is your strongest weapon. Learn the exact phrasing required to force municipal bodies to disclose road repair contracts.</p><div class=\"mt-auto pt-4 flex justify-end opacity-0 group-hover:opacity-100 transition-opacity\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-[#A11212]\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></div></div><div class=\"bg-white border border-black/10 hover:border-[#0A0A0A] transition-all p-6 relative overflow-hidden group cursor-pointer flex flex-col h-64\"><div class=\"flex justify-between items-start mb-4\"><div class=\"bg-black/5 p-2 text-[#0A0A0A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-scale\" aria-hidden=\"true\"><path d=\"M12 3v18\"></path><path d=\"m19 8 3 8a5 5 0 0 1-6 0zV7\"></path><path d=\"M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1\"></path><path d=\"m5 8 3 8a5 5 0 0 1-6 0zV7\"></path><path d=\"M7 21h10\"></path></svg></div><div class=\"text-[10px] font-mono uppercase font-bold tracking-widest text-black/40\">Civil Rights</div></div><h3 class=\"text-xl font-bold leading-tight mb-2 group-hover:text-[#A11212] transition-colors\">Police Encounter Rights</h3><p class=\"text-sm text-black/60 font-medium line-clamp-3\">Understand your fundamental rights when stopped, detained, or questioned by local authorities. What they can and cannot legally do.</p><div class=\"mt-auto pt-4 flex justify-end opacity-0 group-hover:opacity-100 transition-opacity\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-[#A11212]\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></div></div><div class=\"bg-white border border-black/10 hover:border-[#0A0A0A] transition-all p-6 relative overflow-hidden group cursor-pointer flex flex-col h-64\"><div class=\"flex justify-between items-start mb-4\"><div class=\"bg-black/5 p-2 text-[#0A0A0A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-landmark\" aria-hidden=\"true\"><path d=\"M10 18v-7\"></path><path d=\"M11.119 2.205a2 2 0 0 1 1.762 0l7.84 3.846A.5.5 0 0 1 20.5 7h-17a.5.5 0 0 1-.22-.949z\"></path><path d=\"M14 18v-7\"></path><path d=\"M18 18v-7\"></path><path d=\"M3 22h18\"></path><path d=\"M6 18v-7\"></path></svg></div><div class=\"text-[10px] font-mono uppercase font-bold tracking-widest text-black/40\">Governance</div></div><h3 class=\"text-xl font-bold leading-tight mb-2 group-hover:text-[#A11212] transition-colors\">The 74th Amendment Act</h3><p class=\"text-sm text-black/60 font-medium line-clamp-3\">Why your city is broken. The 74th Amendment was supposed to give power to Ward Committees, but state governments refuse to implement it.</p><div class=\"mt-auto pt-4 flex justify-end opacity-0 group-hover:opacity-100 transition-opacity\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-[#A11212]\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></div></div><div class=\"bg-white border border-black/10 hover:border-[#0A0A0A] transition-all p-6 relative overflow-hidden group cursor-pointer flex flex-col h-64\"><div class=\"flex justify-between items-start mb-4\"><div class=\"bg-black/5 p-2 text-[#0A0A0A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg></div><div class=\"text-[10px] font-mono uppercase font-bold tracking-widest text-black/40\">Public Funds</div></div><h3 class=\"text-xl font-bold leading-tight mb-2 group-hover:text-[#A11212] transition-colors\">Reading a Municipal Budget</h3><p class=\"text-sm text-black/60 font-medium line-clamp-3\">How to trace the flow of money from your property taxes to the contractor hired to fix the drainage in your exact sector.</p><div class=\"mt-auto pt-4 flex justify-end opacity-0 group-hover:opacity-100 transition-opacity\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-[#A11212]\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></div></div></div></section><section class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\"><div class=\"bg-[#0A0A0A] text-[#F5F1E8] p-12 flex flex-col justify-center\"><h2 class=\"text-4xl font-bold tracking-tight mb-4\">Host a Digital Townhall</h2><p class=\"text-white/60 mb-8 max-w-md\">Skip the expensive political rallies. Nagrik Party provides the digital infrastructure for citizens to organize hyper-local public hearings with their elected representatives.</p><button class=\"bg-white text-[#0A0A0A] w-max px-8 py-3 font-bold uppercase tracking-widest hover:bg-[#A11212] hover:text-white transition-colors\">Request Platform Access</button></div><div class=\"bg-white border border-black/10 p-12\"><h2 class=\"text-3xl font-bold tracking-tight mb-6 text-[#A11212]\">Downloadable Assets</h2><ul class=\"space-y-4\"><li class=\"flex justify-between items-center pb-4 border-b border-black/10 hover:pl-2 transition-all cursor-pointer\"><span class=\"font-bold\">Constitutional Pocket Guide (Hindi/English)</span><span class=\"font-mono text-xs text-black/40\">PDF / 4MB</span></li><li class=\"flex justify-between items-center pb-4 border-b border-black/10 hover:pl-2 transition-all cursor-pointer\"><span class=\"font-bold\">Standard RTI Templates for Infrastructure</span><span class=\"font-mono text-xs text-black/40\">DOCX / 12KB</span></li><li class=\"flex justify-between items-center pb-4 hover:pl-2 transition-all cursor-pointer\"><span class=\"font-bold\">Ward Committee Formation Guide</span><span class=\"font-mono text-xs text-black/40\">PDF / 2MB</span></li></ul></div></section></main></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-5b1711e075e5183b.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[8946,[\\\"7177\\\",\\\"static/chunks/app/layout-1b93a5baf91874e7.js\\\"],\\\"ThemeProvider\\\"]\\n3:I[57121,[],\\\"\\\"]\\n4:I[74581,[],\\\"\\\"]\\n5:I[61304,[],\\\"ClientPageRoot\\\"]\\n6:I[55029,[\\\"8500\\\",\\\"static/chunks/8500-f62a38ff68ab7f42.js\\\",\\\"9651\\\",\\\"static/chunks/app/education/page-08f0e74ec9d60d53.js\\\"],\\\"default\\\"]\\n9:I[90484,[],\\\"OutletBoundary\\\"]\\na:\\\"$Sreact.suspense\\\"\\nd:I[90484,[],\\\"ViewportBoundary\\\"]\\nf:I[90484,[],\\\"MetadataBoundary\\\"]\\n11:I[27123,[],\\\"default\\\",1]\\n:HL[\\\"/_next/static/css/88074b3575cc8ac4.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/e3f1d182f089bf20.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"education\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"education\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",\\\"$undefined\\\",16],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/88074b3575cc8ac4.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"link\\\",\\\"1\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/e3f1d182f089bf20.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"className\\\":\\\"__variabl